<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Mmopal.Worker</RootNamespace>
    <AssemblyName>Mmopal.Worker</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Mmopal.Domain.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mmopal.Contracts\Mmopal.Contracts.csproj" />
    <ProjectReference Include="..\Mmopal.Gw2\Mmopal.Gw2.csproj" />
    <ProjectReference Include="..\Mmopal.Infrastructure\Mmopal.Infrastructure.csproj" />
    <ProjectReference Include="..\Mmopal.Native\Mmopal.Native.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
    <None Include="..\..\config\appsettings.json" Link="config\appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\config\profiles\*.json" LinkBase="config\profiles" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\templates\tradingpost\*.png" LinkBase="assets\templates\tradingpost" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
