<Window x:Class="Mmopal.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mmopal" Height="560" Width="900" MinHeight="420" MinWidth="700">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Bot:" VerticalAlignment="Center" Margin="4" />
            <ComboBox x:Name="BotSelector" Width="150" SelectedIndex="0" Margin="4">
                <ComboBoxItem Content="Trading Post" Tag="TradingPost" />
                <ComboBoxItem Content="Fishing" Tag="Fishing" />
            </ComboBox>
            <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="12,4,4,4" />
            <ComboBox x:Name="ModeSelector" Width="120" SelectedIndex="0" Margin="4">
                <ComboBoxItem Content="Dry run" Tag="DryRun" />
                <ComboBoxItem Content="Observe" Tag="Observe" />
                <ComboBoxItem Content="Live" Tag="Live" />
            </ComboBox>
            <TextBlock Text="Profile:" VerticalAlignment="Center" Margin="12,4,4,4" />
            <ComboBox x:Name="ProfileSelector" Width="120" SelectedIndex="1" Margin="4">
                <ComboBoxItem Content="Safe" Tag="safe" />
                <ComboBoxItem Content="Balanced" Tag="balanced" />
                <ComboBoxItem Content="Fast" Tag="fast" />
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
            <Button Content="Start" Click="Start_Click" />
            <Button Content="Pause" Click="Pause_Click" />
            <Button Content="Resume" Click="Resume_Click" />
            <Button Content="Stop" Click="Stop_Click" />
            <Button Content="Emergency Stop" Click="EmergencyStop_Click" Background="#FFD36B6B" />
        </StackPanel>

        <GroupBox Grid.Row="2" Header="Worker log">
            <ListBox x:Name="LogList" />
        </GroupBox>

        <StatusBar Grid.Row="3" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Idle" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
