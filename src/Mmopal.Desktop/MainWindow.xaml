                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="FIXTURE PATH (JSONL REPLAY)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="FixturePathBox" ToolTip="Optional JSONL observation fixture to replay." />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="RECORDING PATH (JSONL OUTPUT)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="RecordPathBox" ToolTip="Optional JSONL path for recording screen observations." />
                                                </StackPanel>
                                            </Grid>
                                            <DockPanel>
                                                <CheckBox x:Name="CaptureFramesCheckBox" Content="Capture raw BGRA32 frames alongside recordings" VerticalAlignment="Center" />
                                                <Button DockPanel.Dock="Right" Content="Open Data Folder" Tag="&#xE838;" Click="OpenDataFolder_Click" HorizontalAlignment="Right" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,12,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="&#xE9F9;" Style="{StaticResource GlyphIcon}" FontSize="15" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="Trade Session Report Eligibility" Style="{StaticResource SectionTitle}" />
                                            </StackPanel>
                                            <TextBlock Text="Controls which finished runs are archived to the Session Reports tab (ignores quick accidental Live start/stops unless trades or bugs happened)." Style="{StaticResource HintText}" Margin="0,0,0,10" />
                                            <CheckBox x:Name="SaveSessionReportsCheckBox" Content="Archive eligible trade session reports automatically" IsChecked="True" Margin="0,0,0,6" />
                                            <CheckBox x:Name="ReportIncludeDryRunCheckBox" Content="Also archive Dry run &amp; Observe sessions (otherwise Live sessions only)" IsChecked="False" Margin="0,0,0,6" />
                                            <CheckBox x:Name="ReportSaveOnTradesCheckBox" Content="Always save if any buy/sell order, delivery pickup, or character swap occurred" IsChecked="True" Margin="0,0,0,6" />
                                            <CheckBox x:Name="ReportSaveOnErrorsCheckBox" Content="Always save if any error, bug, recovery, or fault halt occurred" IsChecked="True" Margin="0,0,0,10" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="MIN DURATION WITHOUT TRADES (MINS)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="ReportMinDurationBox" Text="5" ToolTip="Minimum session length in minutes before a quiet session (no trades/errors) is saved." />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="MAX SAVED REPORTS IN ARCHIVE" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="MaxSavedReportsBox" Text="100" ToolTip="Retention limit (10–1000) before oldest reports are pruned." />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- ============================================================ -->
                <!-- VIEW 6: GUIDE & PRE-FLIGHT SETUP                             -->
                <!-- ============================================================ -->
                <Grid x:Name="GuideView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Guide &amp; Setup" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Pre-flight readiness checks, 4-step operating walkthrough, and proven GW2 Trading Post principles." Style="{StaticResource HintText}" Margin="0,3,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <!-- Pre-Flight Readiness Checklist -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <TextBlock Text="&#xE9D5;" Style="{StaticResource GlyphIcon}" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0" />
                                            <TextBlock Text="Pre-Flight Readiness Checklist" Style="{StaticResource SectionTitle}" />
                                        </StackPanel>
                                        <Button DockPanel.Dock="Right" Content="Refresh Checks" Tag="&#xE72C;" Padding="10,4" FontSize="11.5" Click="RefreshChecklist_Click" HorizontalAlignment="Right" />
                                    </DockPanel>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CheckApiKeyIcon" Text="&#xE73E;" Style="{StaticResource GlyphIcon}" FontSize="14" />
                                        <TextBlock x:Name="CheckApiKeyText" Grid.Column="1" Text="GW2 API Key (account, tradingpost, wallet)" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="Configure Key" Padding="10,4" FontSize="11.5" Click="GoToSettings_Click" />
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CheckGw2Icon" Text="&#xE73E;" Style="{StaticResource GlyphIcon}" FontSize="14" />
                                        <TextBlock x:Name="CheckGw2Text" Grid.Column="1" Text="Guild Wars 2 Executable" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="Auto-Detect GW2" Padding="10,4" FontSize="11.5" Click="DetectGw2_Click" />
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CheckDpiIcon" Text="&#xE73E;" Style="{StaticResource GlyphIcon}" FontSize="14" />
                                        <TextBlock x:Name="CheckDpiText" Grid.Column="1" Text="Windows Display Scaling = 100%" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE946;" Style="{StaticResource GlyphIcon}" FontSize="14" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="In-game setup: Resolution = Window (Mmopal auto-snaps GW2 to 1024x768), Interface Size = Larger, DPI Scaling = Off, Dynamic HUD = Always Hide All, character parked at TP NPC ('F')." Grid.Column="1" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CheckCandidatesIcon" Text="&#xE73E;" Style="{StaticResource GlyphIcon}" FontSize="14" />
                                        <TextBlock x:Name="CheckCandidatesText" Grid.Column="1" Text="Flip candidates loaded" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="Open Market Scanner" Padding="10,4" FontSize="11.5" Click="GoToScanner_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 4-Step Quickstart -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource GlyphIcon}" FontSize="16" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,9,0" />
                                        <TextBlock Text="4-Step Operating Walkthrough" Style="{StaticResource SectionTitle}" />
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="1. CONNECT &amp; AUTO-TUNE" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="Save your DPAPI API key in Settings, click Test Key, then click Auto-Tune for My Wallet so limits fit your coin stack." Style="{StaticResource HintText}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="2. SCAN &amp; FILTER" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="In Market Scanner, pick a preset (e.g. Balanced), run Scan GW2 Market, verify 'Liquid' signals, then click Use All for Session." Style="{StaticResource HintText}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="3. VERIFY SCREEN OBSERVE" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="Park characters at TP NPCs, click Launch &amp; snap GW2, open the TP ('F'), and test Screen observe in Observe only mode." Style="{StaticResource HintText}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="3" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="4. TRACK REAL PROFIT" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="Sync in Income &amp; Portfolio after trading to archive fills past 90 days, inspect FIFO profit, and catch Outbid buy orders." Style="{StaticResource HintText}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Visual Market Schedule & Flipping Rules -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8D4;" Style="{StaticResource GlyphIcon}" FontSize="16" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,9,0" />
                                            <TextBlock Text="Market Schedule &amp; Flipping Playbook" Style="{StaticResource SectionTitle}" />
                                        </StackPanel>
                                        <TextBlock Text="Shared NA + EU Global Trading Post" Style="{StaticResource HintText}" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </DockPanel>

                                    <TextBlock x:Name="GuideScheduleSummaryText" Text="Calculating market phases in your local timezone..." FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10" TextWrapping="Wrap" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="EuPrimeTile" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="EU PRIME (SHARED TP)" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock x:Name="EuPrimeTimeText" Text="17:00–22:00 UTC" FontWeight="SemiBold" FontSize="13.5" Margin="0,2,0,3" />
                                                <TextBlock x:Name="EuPrimeHintText" Text="Place buy orders" Style="{StaticResource HintText}" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="ResetTile" Grid.Column="1" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="DAILY RESET WINDOW" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource SuccessBrush}" />
                                                <TextBlock x:Name="ResetTimeText" Text="22:00–02:00 UTC" FontWeight="SemiBold" FontSize="13.5" Margin="0,2,0,3" />
                                                <TextBlock x:Name="ResetHintText" Text="Peak global fills" Style="{StaticResource HintText}" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="NaPrimeTile" Grid.Column="2" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="NA PRIME + OVERNIGHT" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource GoldAccentBrush}" />
                                                <TextBlock x:Name="NaPrimeTimeText" Text="02:00–05:00 UTC" FontWeight="SemiBold" FontSize="13.5" Margin="0,2,0,3" />
                                                <TextBlock x:Name="NaPrimeHintText" Text="Overnight 8–10h flips" Style="{StaticResource HintText}" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="OffPeakTile" Grid.Column="3" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="GLOBAL OFF-PEAK" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock x:Name="OffPeakTimeText" Text="05:00–17:00 UTC" FontWeight="SemiBold" FontSize="13.5" Margin="0,2,0,3" />
                                                <TextBlock x:Name="OffPeakHintText" Text="Hold sells, thin book" Style="{StaticResource HintText}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="15% TAX · >= 1.18x" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource SuccessBrush}" />
                                                <TextBlock Text="5% listing + 10% sale fee. Keep Min ROI >= 10%." Style="{StaticResource HintText}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="BUY 0% · SELL -5%" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="Canceling buys is free; never panic-cancel sells." Style="{StaticResource HintText}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="LIQUIDITY &gt; FAKE ROI" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource GoldAccentBrush}" />
                                                <TextBlock Text="12–20% ROI at 250+ volume beats frozen 80% skins." Style="{StaticResource HintText}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="3" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="&lt;=5%/ITEM · 15% RESERVE" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource WarningBrush}" />
                                                <TextBlock Text="Stop buys at 0g or floor; cap runs around 8–10h." Style="{StaticResource HintText}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
