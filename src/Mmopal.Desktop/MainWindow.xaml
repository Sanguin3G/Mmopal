<Window x:Class="Mmopal.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:pages="clr-namespace:Mmopal.Desktop.Pages"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mmopal — GW2 Companion"
        Icon="pack://application:,,,/Mmopal.Desktop;component/Assets/mmopal.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource AppBackgroundBrush}"
        Height="800" Width="1300" MinHeight="560" MinWidth="520"
        SizeChanged="Window_SizeChanged"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar Rail -->
        <Border x:Name="SidebarBorder"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16,20">
            <DockPanel LastChildFill="True">
                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="2,0,2,22">
                    <StackPanel x:Name="SidebarBrandRow" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="SidebarBrandIconBorder" Width="36" Height="36" CornerRadius="9" Background="#121C2E" BorderBrush="{DynamicResource GoldAccentBrush}" BorderThickness="1.5" Margin="0,0,11,0" ToolTip="Mmopal — GW2 Companion">
                            <Viewbox Width="23" Height="23" Stretch="Uniform">
                                <Canvas Width="256" Height="256">
                                    <Polygon Points="128,32 150,56 128,80 106,56" Fill="#4AA9FF" />
                                    <Line X1="128" Y1="88" X2="128" Y2="202" Stroke="#F0B94A" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Rectangle Canvas.Left="84" Canvas.Top="196" Width="88" Height="18" RadiusX="9" RadiusY="9" Fill="#F0B94A" />
                                    <Line X1="52" Y1="120" X2="204" Y2="96" Stroke="#F0B94A" StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Line X1="52" Y1="120" X2="34" Y2="168" Stroke="#F0B94A" StrokeThickness="9" />
                                    <Line X1="52" Y1="120" X2="70" Y2="168" Stroke="#F0B94A" StrokeThickness="9" />
                                    <Path Data="M 28,168 L 76,168 Q 52,198 28,168 Z" Fill="#F0B94A" />
                                    <Line X1="204" Y1="96" X2="186" Y2="144" Stroke="#F0B94A" StrokeThickness="9" />
                                    <Line X1="204" Y1="96" X2="222" Y2="144" Stroke="#F0B94A" StrokeThickness="9" />
                                    <Path Data="M 180,144 L 228,144 Q 204,174 180,144 Z" Fill="#F0B94A" />
                                    <Ellipse Canvas.Left="194" Canvas.Top="122" Width="20" Height="20" Fill="#4AA9FF" />
                                    <Ellipse Canvas.Left="114" Canvas.Top="95" Width="28" Height="28" Fill="#F0B94A" />
                                    <Ellipse Canvas.Left="121" Canvas.Top="102" Width="14" Height="14" Fill="#121C2E" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel x:Name="SidebarBrandText" VerticalAlignment="Center">
                            <TextBlock Text="MMOPAL" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="GW2 COMPANION" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Footer: Theme + Status + Hotkey Hint -->
                <StackPanel x:Name="SidebarFooterPanel" DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Border x:Name="SidebarStatusBorder"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="12,10"
                            Margin="0,0,0,12"
                            ToolTip="Status: Ready (Offline)">
                        <StackPanel x:Name="SidebarStatusStack">
                            <StackPanel x:Name="SidebarStatusRow" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="SidebarStatusDot" Fill="{DynamicResource SuccessBrush}" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="SidebarStatusLabel" Text="Ready (Offline)" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock x:Name="SidebarHotkeyHint" Text="Pause: Ctrl+Shift+P  •  Stop: Ctrl+Shift+S" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="SidebarFooterExpanded">
                        <TextBlock Text="ACTIVE ACCOUNT" Style="{StaticResource FieldLabel}" Margin="2,0,0,4" />
                        <ComboBox x:Name="SidebarAccountSelector" SelectionChanged="SidebarAccountSelector_SelectionChanged" Margin="0,0,0,10" />

                        <TextBlock Text="APPEARANCE" Style="{StaticResource FieldLabel}" Margin="2,0,0,4" />
                        <ComboBox x:Name="ThemeSelector" SelectedIndex="0" SelectionChanged="ThemeSelector_SelectionChanged">
                            <ComboBoxItem Content="System" />
                            <ComboBoxItem Content="Dark" />
                            <ComboBoxItem Content="Light" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Items -->
                <StackPanel>
                    <TextBlock x:Name="SidebarWorkspaceLabel" Text="WORKSPACE" Style="{StaticResource FieldLabel}" Margin="6,0,0,6" />
                    <RadioButton x:Name="NavSession" Style="{StaticResource NavButton}" GroupName="Nav" IsChecked="True" Checked="Nav_Checked" ToolTip="Session Control Room">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource GlyphIcon}" FontSize="15" Margin="0,0,11,0" />
                            <TextBlock x:Name="NavSessionLabel" Text="Session" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavIncome" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked" ToolTip="Income &amp; Portfolio">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" Style="{StaticResource GlyphIcon}" FontSize="15" Margin="0,0,11,0" />
                            <TextBlock x:Name="NavIncomeLabel" Text="Income &amp; Portfolio" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavReports" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked" ToolTip="Session Reports">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F9;" Style="{StaticResource GlyphIcon}" FontSize="15" Margin="0,0,11,0" />
                            <TextBlock x:Name="NavReportsLabel" Text="Session Reports" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavScanner" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked" ToolTip="Market Scanner">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource GlyphIcon}" FontSize="15" Margin="0,0,11,0" />
                            <TextBlock x:Name="NavScannerLabel" Text="Market Scanner" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavLists" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked" ToolTip="Lists &amp; Blacklist">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" Style="{StaticResource GlyphIcon}" FontSize="15" Margin="0,0,11,0" />
                            <TextBlock x:Name="NavListsLabel" Text="Lists &amp; Blacklist" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked" ToolTip="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource GlyphIcon}" FontSize="15" Margin="0,0,11,0" />
                            <TextBlock x:Name="NavSettingsLabel" Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavGuide" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked" ToolTip="Guide &amp; Setup">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE897;" Style="{StaticResource GlyphIcon}" FontSize="15" Margin="0,0,11,0" />
                            <TextBlock x:Name="NavGuideLabel" Text="Guide &amp; Setup" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Border x:Name="MainContentBorder" Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}" Padding="24,20">
            <Grid>

                <!-- ============================================================ -->
                <!-- VIEW 1: SESSION DASHBOARD                                    -->
                <!-- ============================================================ -->
                <Grid x:Name="SessionView" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Page Header -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Session Control Room" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SessionSubtitleText" Text="Supervise your trading worker, snap Guild Wars 2 to 1024x768, and monitor live health." Style="{StaticResource HintText}" Margin="0,3,0,0" />
                        </StackPanel>
                        <WrapPanel x:Name="SessionHeaderPills" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Border x:Name="SessionClockPillBorder"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="8,3"
                                    Margin="0,0,6,4"
                                    ToolTip="Elapsed time for the current trade session">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SessionClockIcon" Text="&#xE916;" Style="{StaticResource GlyphIcon}" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SessionClockText" Text="00:00:00" FontFamily="Segoe UI" FontSize="11.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="MarketCyclePillBorder"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="8,3"
                                    Margin="0,0,6,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE823;" Style="{StaticResource GlyphIcon}" FontSize="11" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,5,0" />
                                    <TextBlock x:Name="MarketCyclePillText" Text="TP cycle" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="SafeModePillBorder"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="8,3"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SafeModePillIcon" Text="&#xE72E;" Style="{StaticResource GlyphIcon}" FontSize="11" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,5,0" />
                                    <TextBlock x:Name="SafeModePillText" Text="Safe · No input" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </Grid>

                    <!-- Setup Readiness Banner -->
                    <Border x:Name="ReadinessBanner"
                            Grid.Row="1"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,10"
                            Margin="0,0,0,14">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button Content="Open Guide &amp; Setup" Tag="&#xE897;" Style="{StaticResource PrimaryButton}" Padding="11,6" Click="OpenGuide_Click" Margin="0,0,8,0" />
                                <Button Content="Dismiss" Padding="10,6" Click="DismissReadinessBanner_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE946;" Style="{StaticResource GlyphIcon}" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                                <TextBlock x:Name="ReadinessBannerText" Text="Checking setup readiness..." FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Session Setup Card (Clean 3-Zone Control Layout) -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,12">
                        <StackPanel>
                            <!-- Zone 1: Core Selectors -->
                            <UniformGrid x:Name="SessionSelectorsGrid" Columns="4">
                                <StackPanel Margin="0,0,10,6">
                                    <TextBlock Text="ACTIVITY" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="BotSelector" SelectedIndex="0">
                                        <ComboBoxItem Content="Trading Post" Tag="TradingPost" />
                                        <ComboBoxItem Content="Fishing" Tag="Fishing" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,6">
                                    <TextBlock Text="RUN MODE" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ModeSelector" SelectedIndex="0" SelectionChanged="ModeSelector_SelectionChanged">
                                        <ComboBoxItem Content="Dry run" Tag="DryRun" />
                                        <ComboBoxItem Content="Observe only" Tag="Observe" />
                                        <ComboBoxItem Content="Live (Armed trading)" Tag="Live" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,6">
                                    <TextBlock Text="PACE" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ProfileSelector" SelectedIndex="1" SelectionChanged="ProfileSelector_SelectionChanged">
                                        <ComboBoxItem x:Name="PaceSafeItem" Content="Safe" Tag="safe" />
                                        <ComboBoxItem x:Name="PaceBalancedItem" Content="Balanced" Tag="balanced" />
                                        <ComboBoxItem x:Name="PaceFastItem" Content="Fast" Tag="fast" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="DATA SOURCE" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="SourceSelector" SelectedIndex="0" SelectionChanged="SourceSelector_SelectionChanged" ToolTip="Live mode always uses Screen observe; choosing Replay data switches Live back to Dry run.">
                                        <ComboBoxItem Content="Replay data" Tag="replay" />
                                        <ComboBoxItem Content="Screen observe" Tag="screen" />
                                    </ComboBox>
                                </StackPanel>
                            </UniformGrid>

                            <!-- Pace details live in the Pace tooltips; kept (collapsed) for the summary text. -->
                            <TextBlock x:Name="SessionPaceSummaryText" Visibility="Collapsed" />

                            <!-- Transport, safety interlocks and client tools (icon buttons with tooltips) in one row. -->
                            <DockPanel Margin="0,4,0,0" LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,4">
                                    <Button x:Name="LaunchSnapButton" Tag="&#xE7F4;" Style="{StaticResource IconButton}" Click="LaunchSnapGw2_Click" Margin="0,0,4,0" ToolTip="Launch &amp; snap GW2: launches Guild Wars 2 (ArenaNet or Steam) and snaps its window to (0, 0) at 1024x768." />
                                    <Button x:Name="SwapCharacterNowButton" Tag="&#xE77B;" Style="{StaticResource IconButton}" Click="SwapCharacterNow_Click" Margin="0,0,4,0" ToolTip="Swap character now, using your swap settings (requires Arm live input)." />
                                    <Button x:Name="DockToggleButton" Tag="&#xE8A7;" Style="{StaticResource IconButton}" Click="DockToggle_Click" Margin="0,0,4,0" ToolTip="Dock beside GW2: fits Mmopal next to the 1024x768 game window, or restores your size." />
                                    <Button x:Name="TryOfflineButton" Tag="&#xE9D9;" Style="{StaticResource IconButton}" Click="TryOfflineSample_Click" ToolTip="Try offline sample: simulates one Trading Post decision without GW2." />
                                </StackPanel>
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="StartSessionButton" Content="Start session" Tag="&#xE768;" Style="{StaticResource PrimaryButton}" Click="Start_Click" Margin="0,0,8,4" />
                                    <Button x:Name="PauseSessionButton" Content="Pause" Tag="&#xE769;" Click="Pause_Click" IsEnabled="False" Margin="0,0,8,4" ToolTip="Pause between steps; Resume continues where it left off." />
                                    <Button x:Name="ResumeSessionButton" Content="Resume" Tag="&#xE72A;" Click="Resume_Click" IsEnabled="False" Margin="0,0,8,4" />
                                    <Button x:Name="StopSessionButton" Content="Stop" Tag="&#xE71A;" Click="Stop_Click" IsEnabled="False" Margin="0,0,8,4" ToolTip="Finish the current step (an order being typed, a listing), then stop and save the session report." />
                                    <Button x:Name="EmergencyStopButton" Content="Emergency stop" Tag="&#xE7BA;" Style="{StaticResource DangerButton}" Click="EmergencyStop_Click" IsEnabled="False" Margin="0,0,14,4" ToolTip="Stop instantly, even in the middle of an action. Use Stop for a normal end." />
                                    <CheckBox x:Name="ArmLiveInputCheckBox" Content="Arm live input" IsChecked="False" Checked="ArmLiveInput_Changed" Unchecked="ArmLiveInput_Changed" VerticalAlignment="Center" Margin="0,0,14,4" ToolTip="Safety interlock: allows real mouse/keyboard input in Live mode." />
                                    <CheckBox x:Name="AutoSellInventoryCheckBox" Content="Auto-list bought items" IsChecked="False" Checked="AutoSellInventory_Changed" Unchecked="AutoSellInventory_Changed" VerticalAlignment="Center" Margin="0,0,0,4" ToolTip="Lists only items Mmopal bought: items it placed buy orders for in the last 30 days and the current shopping list. Other bag items are never touched. Needs an API key with the characters and inventories permissions." />
                                </WrapPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Health KPI Row -->
                    <!-- KPI cards: one large value to read at a glance, a short muted detail line, full text in tooltips. -->
                    <StackPanel Grid.Row="3">
                    <!-- Startup steps: what Mmopal did by itself when it opened (shown only when launch automation runs). -->
                    <Border x:Name="LaunchStepsStrip" Visibility="Collapsed" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10" ToolTip="What Mmopal did by itself on launch. ○ waiting · … running · ✓ done · – skipped · ! failed. Change in Settings → Trading &amp; Portfolio.">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="STARTUP" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="LaunchSyncText" Text="○ Account sync" FontSize="12" Margin="0,0,18,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="LaunchTuneText" Text="○ Auto-Tune" FontSize="12" Margin="0,0,18,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="LaunchScanText" Text="○ Market scan" FontSize="12" VerticalAlignment="Center" />
                        </WrapPanel>
                    </Border>
                    <UniformGrid x:Name="SessionKpiGrid" Columns="4" Margin="0,0,0,6">
                        <Border x:Name="StatusCard" Style="{StaticResource KpiCard}" Margin="0,0,10,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE9D2;" Style="{StaticResource GlyphIcon}" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0" />
                                    <TextBlock Text="STATUS" Style="{StaticResource FieldLabel}" Margin="0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusStateDot" Width="9" Height="9" Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,1,8,0" />
                                    <TextBlock x:Name="StatusStateText" Text="Idle" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="StatusText" Text="Idle — waiting for a session" Style="{StaticResource HintText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxHeight="34" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="GameCard" Style="{StaticResource KpiCard}" Margin="0,0,10,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE7FC;" Style="{StaticResource GlyphIcon}" FontSize="13" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,7,0" />
                                    <TextBlock Text="GAME" Style="{StaticResource FieldLabel}" Margin="0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="GameHeadlineText" Text="—" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="ObservationSourceText" Text="No source yet" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="ObservationUiText" Text="" Style="{StaticResource HintText}" Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="OrdersCard" Style="{StaticResource KpiCard}" Margin="0,0,10,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE8D4;" Style="{StaticResource GlyphIcon}" FontSize="13" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,7,0" />
                                    <TextBlock Text="ORDERS" Style="{StaticResource FieldLabel}" Margin="0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="OrdersHeadlineText" Text="—" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource GoldAccentBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="OrdersDetailText" Text="No orders reported" Style="{StaticResource HintText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ObservationPriceText" Text="-" Visibility="Collapsed" />
                                <TextBlock x:Name="ObservationOrdersText" Text="No orders reported" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="ScheduleCard" Style="{StaticResource KpiCard}" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE823;" Style="{StaticResource GlyphIcon}" FontSize="13" Foreground="{DynamicResource WarningBrush}" Margin="0,0,7,0" />
                                    <TextBlock Text="SCHEDULE" Style="{StaticResource FieldLabel}" Margin="0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="ScheduleHeadlineText" Text="No AFK swap" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SessionCapStatusText" Text="Session cap: 10h" Style="{StaticResource HintText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ObservationTimingText" Text="" Style="{StaticResource HintText}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="AfkSwapStatusText" Text="AFK swap disabled" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <!-- Market list & history strip: what the bot is trading from and what it has learned. -->
                    <Border x:Name="MarketIntelStrip" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource GlyphIcon}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="MarketListStatusText" Text="Shopping list: not started" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,18,0" VerticalAlignment="Center" ToolTip="Session shopping list size and the next automatic Market Scanner re-scan (Market Scanner → Advanced → Auto re-scan)." />
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource GlyphIcon}" FontSize="12" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="PortfolioStatusText" Text="History: —" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" ToolTip="Your last 30 days of trades (Income &amp; Portfolio): proven winners are boosted, items that lost money are skipped. Synced automatically every 45 minutes during a session." />
                        </WrapPanel>
                    </Border>
                    </StackPanel>

                    <!-- Activity Log Card -->
                    <Border Grid.Row="4" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE756;" Style="{StaticResource GlyphIcon}" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0" />
                                    <TextBlock Text="Activity Log" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="LogCountText" Text="0 events" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <CheckBox x:Name="ShowRawLogCheckBox" Content="Raw JSON" IsChecked="False" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button Content="Clear" Tag="&#xE74D;" Click="ClearLog_Click" Padding="10,5" FontSize="12" />
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="LogList" Grid.Row="1" Margin="0,10,0,0"
                                     FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                     FontSize="11.5"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <!-- Tight rows that wrap: more of the log fits, and long lines do not scroll sideways. -->
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="4,1" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============================================================ -->
                <!-- VIEW 2: INCOME & PORTFOLIO TRACKER                           -->
                <!-- ============================================================ -->
                <Grid x:Name="IncomeView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header + Sync Controls (Responsive 2-row Grid keeps Account pill never clipped) -->
                    <Grid x:Name="IncomeHeaderGrid" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Income &amp; Portfolio" Style="{StaticResource PageTitle}" Margin="0,0,10,2" />
                                <Border x:Name="IncomeAccountBadgeBorder"
                                        Background="{DynamicResource SurfaceRaisedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="10,4"
                                        Margin="0,2,0,2"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="IncomeActiveAccountText" Text="No active account" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource GoldAccentBrush}" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </WrapPanel>
                            <TextBlock x:Name="IncomeSubtitleText" Text="Net worth over time, profit from sales, stock on the shelf and your buy orders, per account." Style="{StaticResource HintText}" Margin="0,3,0,0" />
                        </StackPanel>
                        <WrapPanel x:Name="IncomeHeaderActionsPanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <ComboBox x:Name="IncomeTimeframeSelector" SelectedIndex="2" MinWidth="128" Width="128" SelectionChanged="IncomeTimeframe_SelectionChanged" Margin="0,0,8,4">
                                <ComboBoxItem Content="Today" Tag="1" />
                                <ComboBoxItem Content="7 Days" Tag="7" />
                                <ComboBoxItem Content="30 Days" Tag="30" />
                                <ComboBoxItem Content="90 Days" Tag="90" />
                                <ComboBoxItem Content="All Time" Tag="0" />
                            </ComboBox>
                            <Button x:Name="SyncPortfolioButton" Content="Sync GW2 Account" Tag="&#xE895;" Style="{StaticResource PrimaryButton}" Click="SyncPortfolio_Click" Margin="0,0,8,4" />
                            <Button Content="Export Ledger CSV" Tag="&#xE74E;" Click="ExportLedgerCsv_Click" Margin="0,0,0,4" />
                        </WrapPanel>
                    </Grid>

                    <!-- Sync Status & Portfolio Advisor Insights Strip -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock x:Name="IncomeSyncStatusText" Text="Click 'Sync GW2 Account' after saving your API key in Settings to archive transactions and track equity." Style="{StaticResource HintText}" Margin="0,0,0,6" />
                        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource GlyphIcon}" FontSize="12" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,8,0" />
                                <TextBlock x:Name="PortfolioInsightsText" Text="Live Advisor ready — sync trades to unlock FIFO winner boosts &amp; chronic-loser guards." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="LosingItemsPanel" Visibility="Collapsed" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,6,0,0">
                            <DockPanel>
                                <Button x:Name="BlacklistLosingItemsButton" DockPanel.Dock="Right" Content="Add to Blacklist" Tag="&#xE8F8;" Click="BlacklistLosingItems_Click" Padding="10,4" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="The bot already skips these while they keep losing; the Blacklist makes it permanent and also hides them from the Market Scanner." />
                                <TextBlock x:Name="LosingItemsText" FontSize="12" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- 4 Portfolio KPI Cards -->
                    <UniformGrid x:Name="IncomeKpiGrid" Grid.Row="2" Columns="4" Margin="0,0,0,6">
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,8">
                            <StackPanel>
                                <TextBlock Text="PROFIT FROM SALES" Style="{StaticResource FieldLabel}" ToolTip="Sale price after the 5% listing and 10% exchange fees, minus what those units cost (matched oldest purchase first). Only items that have sold count." />
                                <TextBlock x:Name="IncomeMatchedProfitText" Text="0c" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource GoldAccentBrush}" />
                                <TextBlock x:Name="IncomeMatchedSubText" TextWrapping="NoWrap" Text="ROI 0.0% • 0 sold • fees 0c" Style="{StaticResource HintText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="IncomeProfitNoteText" TextWrapping="NoWrap" Text="" Style="{StaticResource HintText}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="Sales with no recorded purchase: bought before the GW2 API's 90-day history, or loot. They are income but not flip profit, so they are left out above." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,8">
                            <StackPanel>
                                <TextBlock Text="NET WORTH" Style="{StaticResource FieldLabel}" ToolTip="Everything on the trading account: wallet + gold in buy orders + listings (after fees) + Delivery Box. The best single number for 'am I making money'." />
                                <TextBlock x:Name="IncomeTotalEquityText" Text="—" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" />
                                <TextBlock x:Name="IncomeNetWorthChangeText" TextWrapping="NoWrap" Text="Sync to start tracking" Style="{StaticResource HintText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="IncomeEquityBreakdownText" TextWrapping="NoWrap" Text="" Style="{StaticResource HintText}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,8">
                            <StackPanel>
                                <TextBlock Text="STOCK ON THE SHELF" Style="{StaticResource FieldLabel}" ToolTip="Your listings: what they would bring after fees if they sold at your prices, how many are undercut, and what the unsold units cost you." />
                                <TextBlock x:Name="IncomeDeliveryText" Text="—" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock x:Name="IncomeUnmatchedText" TextWrapping="NoWrap" Text="No listings yet" Style="{StaticResource HintText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="IncomeShelfNoteText" TextWrapping="NoWrap" Text="" Style="{StaticResource HintText}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource KpiCard}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="GOLD IN BUY ORDERS" Style="{StaticResource FieldLabel}" ToolTip="Gold waiting in buy orders. Outbid orders are free to cancel and re-place; the bot keeps at most the share set in Settings → Trading &amp; Portfolio here." />
                                <TextBlock x:Name="IncomeOrdersHealthText" Text="—" FontSize="20" FontWeight="Bold" />
                                <TextBlock x:Name="IncomeOrdersSubText" TextWrapping="NoWrap" Text="No buy orders" Style="{StaticResource HintText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Interactive Charts Row -->
                    <Grid x:Name="IncomeChartsGrid" Grid.Row="3" Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="IncomeChartsLeftCol" Width="1.2*" />
                            <ColumnDefinition x:Name="IncomeChartsRightCol" Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Daily Realized Profit Chart -->
                        <Border x:Name="DailyProfitChartCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,12,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="IncomeChartModeSelector" SelectedIndex="0" Width="150" HorizontalAlignment="Left" SelectionChanged="IncomeChartMode_SelectionChanged" ToolTip="Net worth over time is the honest headline; daily profit only counts items that sold. Hover bars for values.">
                                        <ComboBoxItem Content="Net worth over time" Tag="NetWorth" />
                                        <ComboBoxItem Content="Profit per day" Tag="DailyProfit" />
                                        <ComboBoxItem x:Name="HourlyChartModeItem" Content="Activity by hour" Tag="Hourly" />
                                    </ComboBox>
                                    <TextBlock x:Name="DailyChartSummaryText" Grid.Column="1" Text="" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" Margin="8,0,0,0" />
                                </Grid>
                                <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="10,10,10,6" Height="108">
                                    <ItemsControl x:Name="DailyProfitChartItems">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ToolTip="{Binding Tooltip}" Margin="2,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Border Background="{Binding BarBrush}"
                                                            Height="{Binding BarHeight}"
                                                            VerticalAlignment="Bottom"
                                                            CornerRadius="3,3,0,0"
                                                            MinWidth="4"
                                                            MaxWidth="26" />
                                                    <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Local Hour-of-Day Activity Chart -->
                        <Border x:Name="HourlyActivityChartCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Padding="16,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Activity by Local Hour (00–23)" Style="{StaticResource FieldLabel}" Margin="0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="HourlyChartSummaryText" Grid.Column="1" Text="Local timezone" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" Margin="8,0,0,0" />
                                </Grid>
                                <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="10,10,10,6" Height="108">
                                    <ItemsControl x:Name="HourlyActivityChartItems">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ToolTip="{Binding Tooltip}" Margin="1,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Border Background="{Binding BarBrush}"
                                                            Height="{Binding BarHeight}"
                                                            VerticalAlignment="Bottom"
                                                            CornerRadius="3,3,0,0"
                                                            MinWidth="4" />
                                                    <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Tabbed Tables -->
                    <TabControl Grid.Row="4">
                        <TabItem Header="Item P&amp;L Leaderboard">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="Filter item:" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox x:Name="IncomeSearchBox" Width="180" Height="28" Padding="6,2" VerticalContentAlignment="Center" TextChanged="IncomeSearchBox_TextChanged" ToolTip="Filter leaderboard by item name" />
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Content="Blacklist selected" Tag="&#xE8F8;" Style="{StaticResource CompactButton}" Click="BlacklistSelectedPnlItem_Click" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>
                                <DataGrid x:Name="ItemPnlGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ITEM NAME" Binding="{Binding ItemName}" Width="2.1*" MinWidth="135" />
                                        <DataGridTextColumn Header="QTY" Binding="{Binding UnitsFlipped}" Width="0.6*" MinWidth="46" />
                                        <DataGridTextColumn Header="AVG BUY" Binding="{Binding AvgBuyFormatted}" Width="0.95*" MinWidth="75" />
                                        <DataGridTextColumn Header="AVG SELL" Binding="{Binding AvgSellFormatted}" Width="0.95*" MinWidth="75" />
                                        <DataGridTextColumn Header="NET PROFIT" Binding="{Binding NetProfitFormatted}" Width="1*" MinWidth="82" />
                                        <DataGridTextColumn Header="ROI" Binding="{Binding RoiFormatted}" Width="0.65*" MinWidth="54" />
                                        <DataGridTextColumn Header="HOLD" Binding="{Binding AvgHoldFormatted}" Width="0.65*" MinWidth="56" />
                                        <DataGridTextColumn Header="OUTCOME" Binding="{Binding OutcomeBadge}" Width="0.8*" MinWidth="72" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Active Orders">
                            <DataGrid x:Name="ActiveOrdersGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SIDE" Binding="{Binding Side}" Width="0.6*" />
                                    <DataGridTextColumn Header="ITEM NAME" Binding="{Binding ItemName}" Width="2.1*" />
                                    <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="0.55*" />
                                    <DataGridTextColumn Header="YOUR PRICE" Binding="{Binding YourPriceFormatted}" Width="1*" />
                                    <DataGridTextColumn Header="MARKET TOP" Binding="{Binding MarketTopFormatted}" Width="1*" />
                                    <DataGridTextColumn Header="BOOK STATUS" Binding="{Binding BookStatus}" Width="0.9*" />
                                    <DataGridTextColumn Header="CREATED" Binding="{Binding CreatedFormatted}" Width="1.1*" />
                                    <DataGridTextColumn Header="AGE" Binding="{Binding AgeFormatted}" Width="0.5*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="Synced Ledger">
                            <DataGrid x:Name="LedgerHistoryGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PURCHASED" Binding="{Binding PurchasedFormatted}" Width="1.15*" />
                                    <DataGridTextColumn Header="SIDE" Binding="{Binding Side}" Width="0.55*" />
                                    <DataGridTextColumn Header="ITEM NAME" Binding="{Binding ItemName}" Width="2.1*" />
                                    <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="0.55*" />
                                    <DataGridTextColumn Header="UNIT PRICE" Binding="{Binding UnitPriceFormatted}" Width="1*" />
                                    <DataGridTextColumn Header="GROSS TOTAL" Binding="{Binding GrossTotalFormatted}" Width="1.05*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- ============================================================ -->
                <!-- VIEW 2B: TRADE SESSION REPORTS (ARCHIVE & AUDIT)             -->
                <!-- ============================================================ -->
                <pages:ReportsPage x:Name="ReportsPage" />

                <!-- ============================================================ -->
                <!-- VIEW 3: BUILT-IN PROFITABLE ITEM FINDER (MARKET SCANNER)     -->
                <!-- ============================================================ -->
                <Grid x:Name="ScannerView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Market Scanner" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Discover liquid flips from the official GW2 API with wall-depth checks, presets, and cached instant re-filtering." Style="{StaticResource HintText}" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Filter & Preset Card -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,16">
                        <StackPanel>
                            <!-- Strategy Preset Strip -->
                            <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                                <TextBlock Text="PRESETS:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,4" />
                                <Button Content="Starter (&lt; 100g)" CommandParameter="Starter (&lt; 100g)" Click="ApplyScannerPreset_Click" Padding="10,5" FontSize="11.5" Margin="0,0,6,4" />
                                <Button Content="Balanced (100g–1k)" CommandParameter="Balanced (100g–1,000g)" Click="ApplyScannerPreset_Click" Padding="10,5" FontSize="11.5" Margin="0,0,6,4" />
                                <Button Content="High Capital (1k+)" CommandParameter="High Capital (1,000g+)" Click="ApplyScannerPreset_Click" Padding="10,5" FontSize="11.5" Margin="0,0,6,4" />
                                <Button Content="High-Volume Safe" CommandParameter="High-Volume Safe" Click="ApplyScannerPreset_Click" Padding="10,5" FontSize="11.5" Margin="0,0,10,4" />
                                <Button x:Name="AutoTuneScannerButton" Content="Auto-Tune from Wallet" Tag="&#xE9D9;" Click="AutoTuneForWallet_Click" Padding="10,5" FontSize="11.5" Margin="0,0,0,4" />
                            </WrapPanel>

                            <!-- Primary Clean 4-Column Responsive Filter Grid -->
                            <UniformGrid x:Name="ScannerCoreFiltersGrid" Columns="4" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,10,4">
                                    <TextBlock Text="MIN ROI %" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ScanMinRoiBox" Text="10" ToolTip="Must beat GW2 15% tax; 10–15% is standard." />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,4">
                                    <TextBlock Text="MAX BUY (G)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ScanMaxBuyGoldBox" Text="50" ToolTip="Maximum unit buy price in gold. Blank = no cap." />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,4">
                                    <TextBlock Text="CATEGORY" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ScanCategorySelector" SelectedIndex="0">
                                        <ComboBoxItem Content="All Categories" Tag="All" />
                                        <ComboBoxItem Content="Crafting Material" Tag="CraftingMaterial" />
                                        <ComboBoxItem Content="Upgrade (Runes/Sigils)" Tag="UpgradeComponent" />
                                        <ComboBoxItem Content="Consumable" Tag="Consumable" />
                                        <ComboBoxItem Content="Weapon" Tag="Weapon" />
                                        <ComboBoxItem Content="Armor" Tag="Armor" />
                                        <ComboBoxItem Content="Trinket" Tag="Trinket" />
                                        <ComboBoxItem Content="Bag" Tag="Bag" />
                                        <ComboBoxItem Content="Container" Tag="Container" />
                                        <ComboBoxItem Content="Gizmo" Tag="Gizmo" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,4">
                                    <TextBlock Text="SORT BY" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ScanSortSelector" SelectedIndex="0" ToolTip="Est. profit/day = net profit per unit × trades per day (7-day DataWars2 average, capped at 20). Favors items that actually fill over wide spreads that never trade.">
                                        <ComboBoxItem Content="Est. profit/day" Tag="GoldPerDay" />
                                        <ComboBoxItem Content="Balanced Score" Tag="BalancedScore" />
                                        <ComboBoxItem Content="Net Profit" Tag="NetProfit" />
                                        <ComboBoxItem Content="ROI %" Tag="Roi" />
                                        <ComboBoxItem Content="Liquidity" Tag="Liquidity" />
                                    </ComboBox>
                                </StackPanel>
                            </UniformGrid>

                            <!-- Collapsible More Filters (De-clutters 9 rarely-changed controls) -->
                            <Expander x:Name="ScannerAdvancedExpander" IsExpanded="False" Margin="0,0,0,12" Padding="12,8" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}">
                                <Expander.Header>
                                    <TextBlock Text="More Filters (ROI cap, depth, rarity, trades/day, scan scope &amp; walls)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </Expander.Header>
                                <StackPanel>
                                    <UniformGrid x:Name="ScannerAdvancedFiltersGrid" Columns="4" Margin="0,0,0,8">
                                        <StackPanel Margin="0,0,10,6">
                                            <TextBlock Text="MAX ROI %" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ScanMaxRoiBox" Text="120" ToolTip="Caps suspicious wide spreads that are often dead or manipulated. Blank = no cap." />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,6">
                                            <TextBlock Text="MIN PROFIT (S)" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ScanMinProfitSilverBox" Text="5" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,6">
                                            <TextBlock Text="MIN BUY (S)" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ScanMinBuySilverBox" Text="10" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="RARITY" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="ScanRaritySelector" SelectedIndex="0">
                                                <ComboBoxItem Content="All" Tag="All" />
                                                <ComboBoxItem Content="Fine" Tag="Fine" />
                                                <ComboBoxItem Content="Masterwork" Tag="Masterwork" />
                                                <ComboBoxItem Content="Rare" Tag="Rare" />
                                                <ComboBoxItem Content="Exotic" Tag="Exotic" />
                                                <ComboBoxItem Content="Ascended" Tag="Ascended" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,4">
                                            <TextBlock Text="MIN SUPPLY" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ScanMinSupplyBox" Text="100" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,4">
                                            <TextBlock Text="MIN DEMAND" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ScanMinDemandBox" Text="100" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,4">
                                            <TextBlock Text="SCAN SCOPE" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="ScanScopeSelector" SelectedIndex="1" ToolTip="Only used when Min trades/day is 0 or DataWars2 is unreachable. Otherwise every tradable item that trades often enough is checked (whole market).">
                                                <ComboBoxItem Content="Quick (2,000 items)" Tag="2000" />
                                                <ComboBoxItem Content="Standard (6,000 items)" Tag="6000" />
                                                <ComboBoxItem Content="Full Market (All)" Tag="0" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,4">
                                            <TextBlock Text="AUTO RE-SCAN (H)" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="AutoRescanHoursBox" Text="3" ToolTip="During a session that uses the scanned list (Use All for Session), re-run this scan with these filters every N hours and swap in the fresh list. 0 = off. Open orders and items in bags are unaffected." />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,4">
                                            <TextBlock Text="MIN TRADES/DAY" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ScanMinTradesPerDayBox" Text="10" ToolTip="Skip items that trade fewer times per day than this (7-day average of the slower side: buy orders filled vs listings bought). 0 = off. Needs DataWars2; ignored if it is unreachable." />
                                        </StackPanel>
                                    </UniformGrid>
                                    <WrapPanel Orientation="Horizontal">
                                        <CheckBox x:Name="ScanCheckWallsCheckBox" Content="Check order-book walls" IsChecked="True" Margin="0,0,20,4" ToolTip="Queries v2/commerce/listings on matches to catch sell walls and bait spreads." />
                                        <CheckBox x:Name="ScanVelocityCheckBox" Content="Show trades/day (DataWars2)" IsChecked="False" Margin="0,0,20,4" ToolTip="Adds the Trades/day column from api.datawars2.ie. Always fetched when sorting by Est. profit/day or using Min trades/day." />
                                        <CheckBox x:Name="ScanSkipSpikesCheckBox" Content="Skip price spikes" IsChecked="True" Margin="0,0,0,4" ToolTip="Skips items whose top bid or lowest ask is more than 30% above its 7-day average (DataWars2). A spiked price makes the profit look real when it is not, and buying into a spike is how flips lose money." />
                                    </WrapPanel>
                                </StackPanel>
                            </Expander>

                            <!-- Grouped Action Bar: Primary Scan/Session Actions vs Secondary List Actions -->
                            <DockPanel LastChildFill="True">
                                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button Content="Import CSV" Tag="&#xE8E5;" Click="ImportScannerFile_Click" Padding="10,6" FontSize="12" Margin="0,0,6,4" ToolTip="Import GW2BLTC / GW2Profits CSV or JSON" />
                                    <Button Content="Add to List" Tag="&#xE710;" Click="AddSelectedScanToCustomList_Click" Padding="10,6" FontSize="12" Margin="0,0,6,4" ToolTip="Add selected row to Custom Shopping List" />
                                    <Button Content="Blacklist Selected" Tag="&#xE8F8;" Click="BlacklistSelectedScanItem_Click" Padding="10,6" FontSize="12" Margin="0,0,0,4" />
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="ScanMarketButton" Content="Scan GW2 Market" Tag="&#xE721;" Style="{StaticResource PrimaryButton}" Click="ScanMarket_Click" Margin="0,0,8,4" />
                                    <Button x:Name="UseScanResultsButton" Content="Use All for Session" Tag="&#xE73E;" Style="{StaticResource SuccessButton}" Click="UseScanResultsForSession_Click" Margin="0,0,8,4" />
                                    <Button x:Name="ReFilterButton" Content="Re-Filter" Tag="&#xE71C;" Click="ReFilterCachedScan_Click" ToolTip="Instantly re-filter cached Trading Post prices without re-downloading." Margin="0,0,8,4" />
                                    <Button x:Name="CancelScanButton" Content="Cancel" Tag="&#xE711;" Click="CancelScan_Click" IsEnabled="False" Margin="0,0,12,4" />
                                </WrapPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Progress Bar -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="ScanProgressBar" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <TextBlock x:Name="ScanStatusText" Grid.Column="1" Text="Pick a preset or click Scan GW2 Market to find flips." Style="{StaticResource HintText}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Results DataGrid -->
                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                        <DataGrid x:Name="ScanResultsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="ToolTip" Value="{Binding FeeBreakdownTooltip}" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ITEM NAME" Binding="{Binding ItemName}" Width="2*" />
                                <DataGridTextColumn Header="TYPE" Binding="{Binding ItemType}" Width="1*" />
                                <DataGridTextColumn Header="RARITY" Binding="{Binding Rarity}" Width="0.75*" />
                                <DataGridTextColumn Header="HIGHEST BUY" Binding="{Binding BuyFormatted}" Width="0.9*" />
                                <DataGridTextColumn Header="LOWEST SELL" Binding="{Binding SellFormatted}" Width="0.9*" />
                                <DataGridTextColumn Header="NET PROFIT" Binding="{Binding ProfitFormatted}" Width="0.9*" />
                                <DataGridTextColumn Header="ROI" Binding="{Binding RoiFormatted}" Width="0.65*" />
                                <DataGridTextColumn Header="DEMAND" Binding="{Binding BuyQuantity}" Width="0.65*" />
                                <DataGridTextColumn Header="SUPPLY" Binding="{Binding SellQuantity}" Width="0.65*" />
                                <DataGridTextColumn Header="TRADES/DAY" Binding="{Binding VolumeFormatted}" Width="0.8*" />
                                <DataGridTextColumn Header="SIGNAL" Binding="{Binding RiskBadge}" Width="0.8*" />
                                <DataGridTextColumn Header="YOUR HISTORY" Binding="{Binding HistoryNote}" Width="1*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- ============================================================ -->
                <!-- VIEW 4: CUSTOM SHOPPING LIST & BLACKLIST EDITOR              -->
                <!-- ============================================================ -->
                <pages:ListsPage x:Name="ListsPage" />

                <!-- ============================================================ -->
                <!-- VIEW 5: SETTINGS (4 CLEAN SEGMENTED TABS)                    -->
                <!-- ============================================================ -->
                <Grid x:Name="SettingsView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="API keys, game client &amp; recovery, trading strategy, hotkeys." Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="AutoTuneSettingsButton" Content="Auto-Tune" Tag="&#xE9D9;" Click="AutoTuneForWallet_Click" Margin="0,0,8,0" ToolTip="Auto-Tune: sizes max buy price, gold reserve, order size, overbid/undercut and scanner filters from your total gold and your last 14 days of flips. Runs by itself at launch and Start session (Settings → Trading &amp; Portfolio). Session cap and swap interval are left as you set them." />
                            <Button x:Name="SaveAllSettingsButton" Content="Save All" Tag="&#xE74E;" Style="{StaticResource PrimaryButton}" Click="SaveAllSettings_Click" ToolTip="Save all settings" />
                        </StackPanel>
                    </Grid>

                    <TabControl x:Name="SettingsTabControl" Grid.Row="1">
                        <!-- TAB 1: ACCOUNTS & API -->
                        <TabItem Header="Accounts &amp; API">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                <StackPanel Margin="4">
                                    <StackPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8D7;" Style="{StaticResource GlyphIcon}" FontSize="16" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,9,0" />
                                            <TextBlock Text="API Keys" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="Encrypted with Windows DPAPI" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,2,0,0" />
                                        </StackPanel>
                                        <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="ReverifyApiKeysButton" Content="Re-verify all" Tag="&#xE72C;" Style="{StaticResource CompactButton}" Click="ReverifyApiKeys_Click" Margin="0,0,8,4" ToolTip="Re-check every stored key against the GW2 API." />
                                            <Button x:Name="TestApiKeyButton" Content="Test active" Tag="&#xE9D9;" Style="{StaticResource CompactButton}" Click="TestApiKey_Click" Margin="0,0,8,4" ToolTip="Check the active key and read its wallet." />
                                            <Button Content="ArenaNet key page" Tag="&#xE8A7;" Style="{StaticResource CompactButton}" Click="OpenArenaNetApiKeys_Click" Margin="0,0,0,4" ToolTip="Open the ArenaNet applications page to create a key." />
                                        </WrapPanel>
                                    </StackPanel>

                                    <DataGrid x:Name="ApiKeysGrid"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              SelectionMode="Single"
                                              MaxHeight="220"
                                              Margin="0,0,0,14">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="ACTIVE" Width="76">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding UseLabel}"
                                                                CommandParameter="{Binding Id}"
                                                                IsEnabled="{Binding CanUse}"
                                                                Click="UseApiKey_Click"
                                                                Style="{StaticResource CompactButton}"
                                                                Margin="0,2"
                                                                HorizontalAlignment="Stretch" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="ORDER" Width="64">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Button Tag="&#xE70E;"
                                                                    CommandParameter="{Binding Id}"
                                                                    IsEnabled="{Binding CanMoveUp}"
                                                                    Click="MoveApiKeyUp_Click"
                                                                    Style="{StaticResource IconButton}"
                                                                    Margin="0,2,4,2"
                                                                    ToolTip="Move up" />
                                                            <Button Tag="&#xE70D;"
                                                                    CommandParameter="{Binding Id}"
                                                                    IsEnabled="{Binding CanMoveDown}"
                                                                    Click="MoveApiKeyDown_Click"
                                                                    Style="{StaticResource IconButton}"
                                                                    Margin="0,2"
                                                                    ToolTip="Move down" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="STATUS" Width="72">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Foreground="{Binding StatusBrush}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="ACCOUNT" Binding="{Binding AccountName}" Width="*" MinWidth="110" IsReadOnly="True" />
                                            <DataGridTemplateColumn Header="NAME" Width="130">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding CustomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="28"
                                                                 Padding="6,0"
                                                                 FontSize="12"
                                                                 VerticalContentAlignment="Center"
                                                                 Margin="0,2,6,2"
                                                                 LostFocus="ApiKeyName_LostFocus"
                                                                 KeyDown="ApiKeyName_KeyDown"
                                                                 ToolTip="Your label for this account (e.g. Main EU). Saved when you press Enter or click elsewhere." />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="PLATFORM" Binding="{Binding PlatformLabel}" Width="80" IsReadOnly="True" />
                                            <DataGridTemplateColumn Header="API KEY" Width="196">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding MaskedKey}" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11.5" Margin="0,0,6,0" />
                                                            <Button Grid.Column="1"
                                                                    Tag="&#xE8C8;"
                                                                    CommandParameter="{Binding Id}"
                                                                    Click="CopyApiKey_Click"
                                                                    Style="{StaticResource IconButton}"
                                                                    Margin="0,2"
                                                                    ToolTip="Copy API key" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="" Width="44">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Tag="&#xE74D;"
                                                                CommandParameter="{Binding Id}"
                                                                Click="DeleteApiKey_Click"
                                                                Style="{StaticResource IconButton}"
                                                                Margin="0,2"
                                                                ToolTip="Delete this key" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Text="ADD A KEY" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="API key" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3" />
                                        <TextBlock Grid.Column="1" Text="Name (optional)" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3" />
                                        <PasswordBox x:Name="ApiKeyPasswordBox" Grid.Row="1" Height="30" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="Paste an ArenaNet API key with account, tradingpost, wallet, inventories and characters." />
                                        <TextBox x:Name="ApiKeyCustomNameBox" Grid.Row="1" Grid.Column="1" Height="30" Padding="6,1" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Optional label, e.g. Main EU or Steam Alt." />
                                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                                            <Button x:Name="SaveApiKeyButton" Content="Save &amp; verify" Tag="&#xE72E;" Style="{StaticResource PrimaryButton}" Click="SaveApiKey_Click" Margin="0,0,8,0" />
                                            <Button x:Name="ClearApiKeyButton" Tag="&#xE74D;" Style="{StaticResource IconButton}" Click="ClearApiKey_Click" ToolTip="Remove the active key" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Scopes: account, tradingpost, wallet, inventories, characters." FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
                                    <TextBlock x:Name="ApiKeyStatusText" Text="No API key stored yet. Recommended scopes: account, tradingpost, wallet, inventories, characters." Style="{StaticResource HintText}" Margin="0,0,0,10" />

                                    <Expander IsExpanded="False" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="12,8">
                                        <Expander.Header>
                                            <TextBlock Text="Quick Setup Steps (ArenaNet Key Scopes &amp; Multi-Account Tip)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Expander.Header>
                                        <StackPanel>
                                            <TextBlock Text="1. Click 'ArenaNet Key Page' -> New Key and check: account, tradingpost, wallet, inventories, characters (characters+inventories enable bag-aware smart auto-sell)." Style="{StaticResource HintText}" />
                                            <TextBlock Text="2. Paste the key above, give it a nickname, and click Save &amp; Verify Key." Style="{StaticResource HintText}" Margin="0,4,0,0" />
                                            <TextBlock Text="3. Each saved account remembers its Launch Platform (ArenaNet vs Steam) when switched." Style="{StaticResource HintText}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 2: GW2 CLIENT & RECOVERY -->
                        <TabItem Header="GW2 Client &amp; Recovery">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                <StackPanel Margin="4">
                                    <!-- Platform & Client -->
                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="&#xE7F4;" Style="{StaticResource GlyphIcon}" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="Launch Platform &amp; Window" Style="{StaticResource SectionTitle}" />
                                            </StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.25*" />
                                                    <ColumnDefinition Width="2.1*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="LAUNCH PLATFORM" Style="{StaticResource FieldLabel}" />
                                                    <ComboBox x:Name="LaunchPlatformSelector" SelectedIndex="0" SelectionChanged="LaunchPlatformSelector_SelectionChanged" ToolTip="Choose ArenaNet standalone launcher (clicks LOG IN) or Steam (auto-login via steam://rungameid/1284210).">
                                                        <ComboBoxItem Content="ArenaNet Launcher (Gw2-64.exe)" Tag="ArenaNet" />
                                                        <ComboBoxItem Content="Steam (Auto-Login · App 1284210)" Tag="Steam" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                    <TextBlock Text="GW2 EXECUTABLE PATH (OR STEAM:// URI)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="Gw2ExecutablePathBox" ToolTip="Path to Gw2-64.exe or steam://rungameid/1284210" />
                                                </StackPanel>
                                                <Button x:Name="DetectGw2Button" Grid.Column="2" Content="Detect" Tag="&#xE721;" Click="DetectGw2_Click" VerticalAlignment="Bottom" Margin="0,0,8,0" />
                                                <Button Grid.Column="3" Content="Browse" Tag="&#xE8E5;" Click="BrowseGw2_Click" VerticalAlignment="Bottom" />
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.6*" />
                                                    <ColumnDefinition Width="0.7*" />
                                                    <ColumnDefinition Width="0.7*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="STANDALONE LAUNCH ARGUMENTS" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="Gw2LaunchArgsBox" Text="-autologin -windowed" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <TextBlock Text="WIDTH" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="Gw2WidthBox" Text="1024" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="HEIGHT" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="Gw2HeightBox" Text="768" />
                                                </StackPanel>
                                            </Grid>

                                            <WrapPanel>
                                                <CheckBox x:Name="SnapWindowOnStartCheckBox" Content="Auto-snap GW2 to 1024x768 at (0, 0) on start" IsChecked="True" Margin="0,0,18,4" />
                                                <CheckBox x:Name="AutoLaunchGw2CheckBox" Content="Auto-launch GW2 if not running" Margin="0,0,18,4" />
                                                <CheckBox x:Name="AutoDockBesideGw2CheckBox" Content="Auto-dock Mmopal beside GW2 when running" IsChecked="True" Margin="0,0,0,4" ToolTip="Shrinks Mmopal cleanly next to the 1024x768 GW2 window while active so both stay visible, then restores size when stopped." />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Auto-Recovery & Bounded Restarts -->
                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="&#xE72C;" Style="{StaticResource GlyphIcon}" FontSize="15" Foreground="{DynamicResource WarningBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="Auto-Recovery &amp; Bounded Restarts" Style="{StaticResource SectionTitle}" />
                                            </StackPanel>
                                            <TextBlock Text="Handles TP unreachable errors, disconnect kicks to Character Select, and stuck modals before halting." Style="{StaticResource HintText}" Margin="0,0,0,10" />
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="RECOVERY RETRIES" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="MaxRecoveryRetriesBox" Text="3" ToolTip="In-place recovery retries (0–10) for Character Select / TP / Esc before restarting or stopping." />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <TextBlock Text="MAX GAME RESTARTS" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="MaxGameRestartsBox" Text="2" ToolTip="Maximum full GW2 restarts per session (0–5) when in-place retries cannot recover." />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                                    <TextBlock Text="MAX LAUNCH TRIES" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="MaxLaunchAttemptsBox" Text="2" ToolTip="Bounded launch attempts (1–5) before halting safely." />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="WINDOW WAIT (S)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="WindowWaitSecondsBox" Text="45" ToolTip="Seconds to wait for the game window per launch attempt." />
                                                </StackPanel>
                                            </Grid>
                                            <CheckBox x:Name="AutoRestartOnFailureCheckBox" Content="Restart Guild Wars 2 automatically if in-place recovery retries fail (respects Auto-Play &amp; Steam mode)" IsChecked="True" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Network & High Ping -->
                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="&#xE968;" Style="{StaticResource GlyphIcon}" FontSize="15" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="Network Latency &amp; UI Timing" Style="{StaticResource SectionTitle}" />
                                            </StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="LATENCY PROFILE" Style="{StaticResource FieldLabel}" />
                                                    <ComboBox x:Name="LatencyProfileSelector" SelectedIndex="2" SelectionChanged="LatencyProfileSelector_SelectionChanged">
                                                        <ComboBoxItem Content="Low (&lt; 80 ms)" Tag="Low" />
                                                        <ComboBoxItem Content="Normal (80–160 ms)" Tag="Normal" />
                                                        <ComboBoxItem Content="High Ping (200–300 ms · VN-&gt;EU)" Tag="HighPing" />
                                                        <ComboBoxItem Content="Custom" Tag="Custom" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <TextBlock Text="TP UI LOAD WAIT (MS)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="UiLoadWaitMsBox" Text="7500" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                                    <TextBlock Text="ACTION SETTLE (MS)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="ActionSettleDelayMsBox" Text="900" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="API TIMEOUT (S)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="ApiTimeoutSecondsBox" Text="60" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <StackPanel Width="320">
                                                    <TextBlock Text="PRICE ENTRY (BUY &amp; SELL)" Style="{StaticResource FieldLabel}" />
                                                    <ComboBox x:Name="PriceEntryModeSelector" SelectedIndex="0" ToolTip="Type exact price: reads the live top bid / lowest ask in the order dialog, types the exact gold/silver/copper, and checks the Total before placing (sells never below break-even). Click top row: the older method, clicks the first row and taps the spinner; less reliable on high ping.">
                                                        <ComboBoxItem Content="Type exact price (recommended)" Tag="TypeExact" />
                                                        <ComboBoxItem Content="Click top row (older)" Tag="ClickRow" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock x:Name="LatencyDescriptionText" Text="High Ping (200–300 ms): Tuned for VN -&gt; EU Frankfurt without VPN/Mudfish." Style="{StaticResource HintText}" Margin="0,0,0,4" />
                                            <TextBlock x:Name="Gw2DetectHealthText" Text="Windows DPI scale check pending..." Style="{StaticResource HintText}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 3: TRADING & PORTFOLIO -->
                        <TabItem Header="Trading &amp; Portfolio">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                <StackPanel Margin="4">
                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="&#xE9D9;" Style="{StaticResource GlyphIcon}" FontSize="15" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="Profit Rules, Order Margins &amp; Portfolio Intelligence" Style="{StaticResource SectionTitle}" />
                                            </StackPanel>
                                            <TextBlock Text="Includes 15% GW2 fee math (5% listing + 10% exchange). Enable Portfolio Intelligence to boost proven winners and guard against ledger losers." Style="{StaticResource HintText}" Margin="0,0,0,10" />
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="MINIMUM PROFIT %" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="MinimumProfitBox" Tag="MinProfit" TextChanged="TunedField_TextChanged" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <TextBlock Text="MAX BUY PRICE (GOLD)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="MaximumBuyGoldBox" Tag="MaxBuy" TextChanged="TunedField_TextChanged" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                                    <TextBlock Text="DEFAULT QUANTITY" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="DefaultQuantityBox" Text="1" Tag="Quantity" TextChanged="TunedField_TextChanged" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="GOLD FLOOR (NO BUY)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="GoldThresholdNoBuyBox" Tag="GoldFloor" TextChanged="TunedField_TextChanged" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="OVERBID MIN (c)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="OverbidMinBox" Text="1" Tag="Overbid" TextChanged="TunedField_TextChanged" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <TextBlock Text="OVERBID MAX (c)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="OverbidMaxBox" Text="5" Tag="Overbid" TextChanged="TunedField_TextChanged" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                                    <TextBlock Text="UNDERCUT MIN (c)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="UndercutMinBox" Text="1" Tag="Undercut" TextChanged="TunedField_TextChanged" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="UNDERCUT MAX (c)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="UndercutMaxBox" Text="5" Tag="Undercut" TextChanged="TunedField_TextChanged" />
                                                </StackPanel>
                                            </Grid>
                                            <CheckBox x:Name="UsePortfolioIntelligenceCheckBox" Content="Use Income &amp; Portfolio ledger history (boost fast winners, auto-skip chronic losers &amp; heavy sell stacks)" IsChecked="True" Margin="0,0,0,6" />
                                            <CheckBox x:Name="AutomateOnLaunchCheckBox" Content="On launch: sync my GW2 account and scan the market" IsChecked="True" Margin="0,0,0,6" ToolTip="Fills Income &amp; Portfolio and the Market Scanner when Mmopal opens. If the session uses the scanner's list and it is older than the Auto re-scan interval, the fresh scan replaces it." />
                                            <CheckBox x:Name="AutoTuneEachSessionCheckBox" Content="Auto-Tune at every launch and Start session (recommended unless you tune by hand)" IsChecked="True" Margin="0,0,0,6" ToolTip="Sizes buy limits from your total gold (wallet + gold in orders) and adjusts them from your last 14 days of flips: thin margins raise Min ROI, slow sales demand busier items, gold stuck in listings slows buying, idle gold with profitable flips raises order size. Never changes settings mid-session. Any of those you change by hand is kept: Auto-Tune then tunes only the rest." />
                                            <DockPanel x:Name="AutoTuneKeepsPanel" Visibility="Collapsed" Margin="26,0,0,6">
                                                <Button x:Name="ClearAutoTuneKeepsButton" DockPanel.Dock="Right" Content="Let Auto-Tune decide" Click="ClearAutoTuneKeeps_Click" Padding="10,3" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Forget your hand-set values; Auto-Tune sets them again at the next launch or Start session." />
                                                <TextBlock x:Name="AutoTuneKeepsText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <CheckBox x:Name="RelistStaleSellsCheckBox" Content="Relist listings undercut for 12 h+ (items that trade, only if the new price still covers what you paid plus the lost 5% fee)" IsChecked="True" Margin="0,0,0,6" ToolTip="Each relist pays a new 5% listing fee, so this is narrow: listed 12 h or more, undercut, on the scanner's list (it trades), at most once a day per item, and only when the new price still nets more than what Mmopal paid plus the fee lost on the old listing. Anything else waits." />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="Keep at most" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBox x:Name="MaxBuyOrderShareBox" Text="50" Width="56" VerticalAlignment="Center" ToolTip="Share of your total gold (wallet + buy orders + listings after fees) that may sit in buy orders. 0 = no limit." />
                                                <TextBlock Text="% of my gold in buy orders (the rest stays free for items that fill)" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <CheckBox x:Name="UseCustomListOnStartCheckBox" Content="Include Custom Shopping List &amp; Blacklist automatically on Start session" IsChecked="True" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="&#xE823;" Style="{StaticResource GlyphIcon}" FontSize="15" Foreground="{DynamicResource WarningBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="Session Cap, Parked Characters &amp; Keybinds" Style="{StaticResource SectionTitle}" />
                                            </StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="MAX SESSION (HRS)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="MaxSessionHoursBox" Text="10" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <TextBlock Text="PARKED CHARS" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="ParkedCharactersBox" Text="4" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                                    <TextBlock Text="INTERACT KEY" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="InteractKeyBox" Text="F" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="TP KEY" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="TpKeyBox" Text="O" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1.6*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="SWAP EVERY (HRS)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="SwapCharacterHoursBox" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <TextBlock Text="JITTER (± MINS)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="SwapJitterMinutesBox" Text="15" />
                                                </StackPanel>
                                                <CheckBox x:Name="RandomCharacterSwapCheckBox" Grid.Column="2" Content="Pick random character on swap" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                                            </Grid>

                                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                <StackPanel>
                                                    <TextBlock Text="WHEN MAX SESSION DURATION CAP IS REACHED" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource WarningBrush}" />
                                                    <CheckBox x:Name="AutoCloseGameOnCapCheckBox" Content="Finalize cycle, recheck Delivery/sell queue, log out &amp; close Guild Wars 2" IsChecked="True" Margin="0,2,0,6" />
                                                    <CheckBox x:Name="AutoCloseAppOnCapCheckBox" Content="Save Session Report and close Mmopal automatically after countdown" IsChecked="True" Margin="0,0,0,6" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="ShutdownPcOnCapCheckBox" Content="Shut down this PC automatically after countdown (safe unattended overnight shutdown)" IsChecked="False" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBlock Text="COUNTDOWN (S)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <TextBox x:Name="PcShutdownCountdownBox" Text="60" Width="72" Padding="6,4" HorizontalContentAlignment="Center" ToolTip="Countdown seconds (10–600) shown in warning dialog before closing app / shutting down PC." />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 4: HOTKEYS & ADVANCED -->
                        <TabItem Header="Hotkeys &amp; Advanced">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                <StackPanel Margin="4">
                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Text="&#xE765;" Style="{StaticResource GlyphIcon}" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="Global Hotkeys (System-Wide)" Style="{StaticResource SectionTitle}" />
                                            </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="PAUSE / RESUME" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="PauseHotkeyBox" Text="Ctrl+Shift+P" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <TextBlock Text="STOP SESSION" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="StopHotkeyBox" Text="Ctrl+Shift+S" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                                    <TextBlock Text="EMERGENCY STOP" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="EmergencyStopHotkeyBox" Text="Ctrl+Shift+X" />
                                                </StackPanel>
                                                <Button x:Name="ApplyHotkeysButton" Grid.Column="3" Content="Apply Hotkeys" Tag="&#xE73E;" Click="ApplyHotkeys_Click" VerticalAlignment="Bottom" />
                                            </Grid>
                                            <TextBlock x:Name="HotkeyStatusText" Text="Global hotkeys active when the app is running." Style="{StaticResource HintText}" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Text="&#xE8B7;" Style="{StaticResource GlyphIcon}" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="Replay, Recording &amp; File Paths" Style="{StaticResource SectionTitle}" />
                                            </StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="CANDIDATES PATH (JSON / CSV)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="CandidatesPathBox" ToolTip="Optional JSON or CSV list of items to evaluate." />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="BLACKLIST PATH (JSON / CSV)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="BlacklistPathBox" ToolTip="Optional extra blacklist file merged with your in-app blacklist." />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="FIXTURE PATH (JSONL REPLAY)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="FixturePathBox" ToolTip="Optional JSONL observation fixture to replay." />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="RECORDING PATH (JSONL OUTPUT)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="RecordPathBox" ToolTip="Optional JSONL path for recording screen observations." />
                                                </StackPanel>
                                            </Grid>
                                            <DockPanel>
                                                <CheckBox x:Name="CaptureFramesCheckBox" Content="Capture raw BGRA32 frames alongside recordings" VerticalAlignment="Center" />
                                                <Button DockPanel.Dock="Right" Content="Open Data Folder" Tag="&#xE838;" Click="OpenDataFolder_Click" HorizontalAlignment="Right" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,12,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="&#xE9F9;" Style="{StaticResource GlyphIcon}" FontSize="15" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="Trade Session Report Eligibility" Style="{StaticResource SectionTitle}" />
                                            </StackPanel>
                                            <TextBlock Text="Controls which finished runs are archived to the Session Reports tab (ignores quick accidental Live start/stops unless trades or bugs happened)." Style="{StaticResource HintText}" Margin="0,0,0,10" />
                                            <CheckBox x:Name="SaveSessionReportsCheckBox" Content="Archive eligible trade session reports automatically" IsChecked="True" Margin="0,0,0,6" />
                                            <CheckBox x:Name="ReportIncludeDryRunCheckBox" Content="Also archive Dry run &amp; Observe sessions (otherwise Live sessions only)" IsChecked="False" Margin="0,0,0,6" />
                                            <CheckBox x:Name="ReportSaveOnTradesCheckBox" Content="Always save if any buy/sell order, delivery pickup, or character swap occurred" IsChecked="True" Margin="0,0,0,6" />
                                            <CheckBox x:Name="ReportSaveOnErrorsCheckBox" Content="Always save if any error, bug, recovery, or fault halt occurred" IsChecked="True" Margin="0,0,0,10" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="MIN DURATION WITHOUT TRADES (MINS)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="ReportMinDurationBox" Text="5" ToolTip="Minimum session length in minutes before a quiet session (no trades/errors) is saved." />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="MAX SAVED REPORTS IN ARCHIVE" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="MaxSavedReportsBox" Text="100" ToolTip="Retention limit (10–1000) before oldest reports are pruned." />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- ============================================================ -->
                <!-- VIEW 6: GUIDE & PRE-FLIGHT SETUP                             -->
                <!-- ============================================================ -->
                <pages:GuidePage x:Name="GuidePage" />
            </Grid>
        </Border>
    </Grid>
</Window>
