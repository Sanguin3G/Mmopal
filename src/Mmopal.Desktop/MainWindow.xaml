<Window x:Class="Mmopal.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mmopal — GW2 Companion"
        Icon="pack://application:,,,/Mmopal.Desktop;component/Assets/mmopal.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource AppBackgroundBrush}"
        Height="800" Width="1300" MinHeight="560" MinWidth="520"
        SizeChanged="Window_SizeChanged"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="15,13" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="15.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="GlyphIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar Rail -->
        <Border x:Name="SidebarBorder"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16,20">
            <DockPanel LastChildFill="True">
                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="2,0,2,22">
                    <StackPanel x:Name="SidebarBrandRow" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="SidebarBrandIconBorder" Width="36" Height="36" CornerRadius="9" Background="#121C2E" BorderBrush="{DynamicResource GoldAccentBrush}" BorderThickness="1.5" Margin="0,0,11,0" ToolTip="Mmopal — GW2 Companion">
                            <Viewbox Width="23" Height="23" Stretch="Uniform">
                                <Canvas Width="256" Height="256">
                                    <Polygon Points="128,32 150,56 128,80 106,56" Fill="#4AA9FF" />
                                    <Line X1="128" Y1="88" X2="128" Y2="202" Stroke="#F0B94A" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Rectangle Canvas.Left="84" Canvas.Top="196" Width="88" Height="18" RadiusX="9" RadiusY="9" Fill="#F0B94A" />
                                    <Line X1="52" Y1="120" X2="204" Y2="96" Stroke="#F0B94A" StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Line X1="52" Y1="120" X2="34" Y2="168" Stroke="#F0B94A" StrokeThickness="9" />
                                    <Line X1="52" Y1="120" X2="70" Y2="168" Stroke="#F0B94A" StrokeThickness="9" />
                                    <Path Data="M 28,168 L 76,168 Q 52,198 28,168 Z" Fill="#F0B94A" />
                                    <Line X1="204" Y1="96" X2="186" Y2="144" Stroke="#F0B94A" StrokeThickness="9" />
                                    <Line X1="204" Y1="96" X2="222" Y2="144" Stroke="#F0B94A" StrokeThickness="9" />
                                    <Path Data="M 180,144 L 228,144 Q 204,174 180,144 Z" Fill="#F0B94A" />
                                    <Ellipse Canvas.Left="194" Canvas.Top="122" Width="20" Height="20" Fill="#4AA9FF" />
                                    <Ellipse Canvas.Left="114" Canvas.Top="95" Width="28" Height="28" Fill="#F0B94A" />
                                    <Ellipse Canvas.Left="121" Canvas.Top="102" Width="14" Height="14" Fill="#121C2E" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel x:Name="SidebarBrandText" VerticalAlignment="Center">
                            <TextBlock Text="MMOPAL" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="GW2 COMPANION" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Footer: Theme + Status + Hotkey Hint -->
                <StackPanel x:Name="SidebarFooterPanel" DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Border x:Name="SidebarStatusBorder"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="12,10"
                            Margin="0,0,0,12"
                            ToolTip="Status: Ready (Offline)">
                        <StackPanel>
                            <StackPanel x:Name="SidebarStatusRow" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="SidebarStatusDot" Fill="{DynamicResource SuccessBrush}" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="SidebarStatusLabel" Text="Ready (Offline)" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock x:Name="SidebarHotkeyHint" Text="Pause: Ctrl+Shift+P  •  Stop: Ctrl+Shift+S" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="SidebarFooterExpanded">
                        <TextBlock Text="ACTIVE ACCOUNT" Style="{StaticResource FieldLabel}" Margin="2,0,0,4" />
                        <ComboBox x:Name="SidebarAccountSelector" SelectionChanged="SidebarAccountSelector_SelectionChanged" Margin="0,0,0,10" />

                        <TextBlock Text="APPEARANCE" Style="{StaticResource FieldLabel}" Margin="2,0,0,4" />
                        <ComboBox x:Name="ThemeSelector" SelectedIndex="0" SelectionChanged="ThemeSelector_SelectionChanged">
                            <ComboBoxItem Content="System" />
                            <ComboBoxItem Content="Dark" />
                            <ComboBoxItem Content="Light" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Items -->
                <StackPanel>
                    <TextBlock x:Name="SidebarWorkspaceLabel" Text="WORKSPACE" Style="{StaticResource FieldLabel}" Margin="6,0,0,6" />
                    <RadioButton x:Name="NavSession" Style="{StaticResource NavButton}" GroupName="Nav" IsChecked="True" Checked="Nav_Checked" ToolTip="Session Control Room">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource GlyphIcon}" FontSize="15" Margin="0,0,11,0" />
                            <TextBlock x:Name="NavSessionLabel" Text="Session" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavIncome" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked" ToolTip="Income &amp; Portfolio">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" Style="{StaticResource GlyphIcon}" FontSize="15" Margin="0,0,11,0" />
                            <TextBlock x:Name="NavIncomeLabel" Text="Income &amp; Portfolio" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavReports" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked" ToolTip="Session Reports">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F9;" Style="{StaticResource GlyphIcon}" FontSize="15" Margin="0,0,11,0" />
                            <TextBlock x:Name="NavReportsLabel" Text="Session Reports" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavScanner" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked" ToolTip="Market Scanner">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource GlyphIcon}" FontSize="15" Margin="0,0,11,0" />
                            <TextBlock x:Name="NavScannerLabel" Text="Market Scanner" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavLists" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked" ToolTip="Lists &amp; Blacklist">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" Style="{StaticResource GlyphIcon}" FontSize="15" Margin="0,0,11,0" />
                            <TextBlock x:Name="NavListsLabel" Text="Lists &amp; Blacklist" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked" ToolTip="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource GlyphIcon}" FontSize="15" Margin="0,0,11,0" />
                            <TextBlock x:Name="NavSettingsLabel" Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavGuide" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked" ToolTip="Guide &amp; Setup">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE897;" Style="{StaticResource GlyphIcon}" FontSize="15" Margin="0,0,11,0" />
                            <TextBlock x:Name="NavGuideLabel" Text="Guide &amp; Setup" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Border x:Name="MainContentBorder" Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}" Padding="24,20">
            <Grid>

                <!-- ============================================================ -->
                <!-- VIEW 1: SESSION DASHBOARD                                    -->
                <!-- ============================================================ -->
                <Grid x:Name="SessionView" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Page Header -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Session Control Room" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Supervise your trading worker, snap Guild Wars 2 to 1024x768, and monitor live health." Style="{StaticResource HintText}" Margin="0,3,0,0" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Border x:Name="SessionClockPillBorder"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="10,5"
                                    Margin="0,0,8,4"
                                    ToolTip="Elapsed time for the current trade session">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SessionClockIcon" Text="&#xE916;" Style="{StaticResource GlyphIcon}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                    <TextBlock x:Name="SessionClockText" Text="00:00:00" FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="10,5"
                                    Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE823;" Style="{StaticResource GlyphIcon}" FontSize="12" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,6,0" />
                                    <TextBlock x:Name="MarketCyclePillText" Text="Global TP Cycle" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="SafeModePillBorder"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="10,5"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SafeModePillIcon" Text="&#xE72E;" Style="{StaticResource GlyphIcon}" FontSize="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,6,0" />
                                    <TextBlock x:Name="SafeModePillText" Text="Safe mode • Live input disarmed" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </Grid>

                    <!-- Setup Readiness Banner -->
                    <Border x:Name="ReadinessBanner"
                            Grid.Row="1"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,10"
                            Margin="0,0,0,14">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button Content="Open Guide &amp; Setup" Tag="&#xE897;" Style="{StaticResource PrimaryButton}" Padding="11,6" Click="OpenGuide_Click" Margin="0,0,8,0" />
                                <Button Content="Dismiss" Padding="10,6" Click="DismissReadinessBanner_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE946;" Style="{StaticResource GlyphIcon}" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                                <TextBlock x:Name="ReadinessBannerText" Text="Checking setup readiness..." FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Session Setup Card (Clean 3-Zone Control Layout) -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="18,16">
                        <StackPanel>
                            <!-- Zone 1: Core Selectors -->
                            <UniformGrid x:Name="SessionSelectorsGrid" Columns="4">
                                <StackPanel Margin="0,0,10,6">
                                    <TextBlock Text="ACTIVITY" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="BotSelector" SelectedIndex="0">
                                        <ComboBoxItem Content="Trading Post" Tag="TradingPost" />
                                        <ComboBoxItem Content="Fishing" Tag="Fishing" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,6">
                                    <TextBlock Text="RUN MODE" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ModeSelector" SelectedIndex="0" SelectionChanged="ModeSelector_SelectionChanged">
                                        <ComboBoxItem Content="Dry run" Tag="DryRun" />
                                        <ComboBoxItem Content="Observe only" Tag="Observe" />
                                        <ComboBoxItem Content="Live (Armed trading)" Tag="Live" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,6">
                                    <TextBlock Text="PACE" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ProfileSelector" SelectedIndex="1" SelectionChanged="ProfileSelector_SelectionChanged">
                                        <ComboBoxItem Content="Safe" Tag="safe" />
                                        <ComboBoxItem Content="Balanced" Tag="balanced" />
                                        <ComboBoxItem Content="Fast" Tag="fast" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="DATA SOURCE" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="SourceSelector" SelectedIndex="0">
                                        <ComboBoxItem Content="Replay data" Tag="replay" />
                                        <ComboBoxItem Content="Screen observe" Tag="screen" />
                                    </ComboBox>
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock x:Name="SessionPaceSummaryText"
                                       Text="Balanced: 3 actions/pass · 50s interval — optimal for 5-min GW2 API cache  •  Platform: ArenaNet"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,10" />

                            <!-- Zone 2: Primary Transport & Live Safety Interlocks -->
                            <DockPanel Margin="0,0,0,10" LastChildFill="True">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="StartSessionButton" Content="Start session" Tag="&#xE768;" Style="{StaticResource PrimaryButton}" Click="Start_Click" Margin="0,0,8,4" />
                                    <Button x:Name="PauseSessionButton" Content="Pause" Tag="&#xE769;" Click="Pause_Click" IsEnabled="False" Margin="0,0,8,4" />
                                    <Button x:Name="ResumeSessionButton" Content="Resume" Tag="&#xE768;" Click="Resume_Click" IsEnabled="False" Margin="0,0,8,4" />
                                    <Button x:Name="StopSessionButton" Content="Stop" Tag="&#xE71A;" Click="Stop_Click" IsEnabled="False" Margin="0,0,8,4" />
                                    <Button x:Name="EmergencyStopButton" Content="Emergency stop" Tag="&#xE7BA;" Style="{StaticResource DangerButton}" Click="EmergencyStop_Click" IsEnabled="False" Margin="0,0,16,4" />
                                    <CheckBox x:Name="ArmLiveInputCheckBox" Content="Arm live input" IsChecked="False" Checked="ArmLiveInput_Changed" Unchecked="ArmLiveInput_Changed" VerticalAlignment="Center" Margin="0,0,16,4" ToolTip="Safety interlock: allows real mouse/keyboard input in Live mode." />
                                    <CheckBox x:Name="AutoSellInventoryCheckBox" Content="Auto-list bought flip items from bags" IsChecked="False" VerticalAlignment="Center" Margin="0,0,0,4" ToolTip="Off by default so unrelated bag items are never touched. Lists only items bought during flipping." />
                                </WrapPanel>
                            </DockPanel>

                            <!-- Zone 3: Quick Client & Utility Tools Strip -->
                            <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,7">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="CLIENT TOOLS:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="2,0,10,0" />
                                    <Button x:Name="LaunchSnapButton" Content="Launch &amp; snap GW2" Tag="&#xE7F4;" Click="LaunchSnapGw2_Click" Padding="10,5" FontSize="12" ToolTip="Launches Guild Wars 2 (ArenaNet or Steam) and snaps its window to (0, 0) at 1024x768." Margin="0,0,8,2" />
                                    <Button x:Name="SwapCharacterNowButton" Content="Swap char now" Tag="&#xE77B;" Click="SwapCharacterNow_Click" Padding="10,5" FontSize="12" ToolTip="Tests parked character rotation right now using your Swap Settings (requires Arm live input)." Margin="0,0,8,2" />
                                    <Button x:Name="DockToggleButton" Content="Dock beside GW2" Tag="&#xE8A7;" Click="DockToggle_Click" Padding="10,5" FontSize="12" ToolTip="Fits Mmopal cleanly alongside GW2 (1024x768) or restores your original window size." Margin="0,0,8,2" />
                                    <Button x:Name="TryOfflineButton" Content="Try offline sample" Tag="&#xE9D9;" Click="TryOfflineSample_Click" Padding="10,5" FontSize="12" ToolTip="Safely simulates one Trading Post decision without GW2." Margin="0,0,0,2" />
                                </WrapPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Health KPI Row -->
                    <UniformGrid x:Name="SessionKpiGrid" Grid.Row="3" Columns="4" Margin="0,0,0,6">
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE9D2;" Style="{StaticResource GlyphIcon}" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0" />
                                    <TextBlock Text="STATUS" Style="{StaticResource FieldLabel}" Margin="0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="StatusText" Text="Idle — waiting for a session" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE7B3;" Style="{StaticResource GlyphIcon}" FontSize="13" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,7,0" />
                                    <TextBlock Text="CLIENT &amp; UI" Style="{StaticResource FieldLabel}" Margin="0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="ObservationSourceText" Text="No source selected yet" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ObservationUiText" Text="No UI state reported" Style="{StaticResource HintText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE8D4;" Style="{StaticResource GlyphIcon}" FontSize="13" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,7,0" />
                                    <TextBlock Text="PRICE &amp; ORDERS" Style="{StaticResource FieldLabel}" Margin="0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="ObservationPriceText" Text="—" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource GoldAccentBrush}" />
                                <TextBlock x:Name="ObservationOrdersText" Text="No orders reported" Style="{StaticResource HintText}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource KpiCard}" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE823;" Style="{StaticResource GlyphIcon}" FontSize="13" Foreground="{DynamicResource WarningBrush}" Margin="0,0,7,0" />
                                    <TextBlock Text="SCHEDULE &amp; PING" Style="{StaticResource FieldLabel}" Margin="0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="ObservationTimingText" Text="No timing data yet" Style="{StaticResource HintText}" />
                                <TextBlock x:Name="AfkSwapStatusText" Text="AFK swap disabled" Style="{StaticResource HintText}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                                <TextBlock x:Name="SessionCapStatusText" Text="Session cap: 10h" Style="{StaticResource HintText}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Activity Log Card -->
                    <Border Grid.Row="4" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE756;" Style="{StaticResource GlyphIcon}" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0" />
                                    <TextBlock Text="Activity Log" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="LogCountText" Text="0 events" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <CheckBox x:Name="ShowRawLogCheckBox" Content="Raw JSON" IsChecked="False" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button Content="Clear" Tag="&#xE74D;" Click="ClearLog_Click" Padding="10,5" FontSize="12" />
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="LogList" Grid.Row="1" Margin="0,12,0,0"
                                     FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                     FontSize="12"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============================================================ -->
                <!-- VIEW 2: INCOME & PORTFOLIO TRACKER                           -->
                <!-- ============================================================ -->
                <Grid x:Name="IncomeView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header + Sync Controls (Responsive 2-row Grid keeps Account pill never clipped) -->
                    <Grid x:Name="IncomeHeaderGrid" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Income &amp; Portfolio" Style="{StaticResource PageTitle}" Margin="0,0,10,2" />
                                <Border x:Name="IncomeAccountBadgeBorder"
                                        Background="{DynamicResource SurfaceRaisedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="10,4"
                                        Margin="0,2,0,2"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="IncomeActiveAccountText" Text="No active account" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource GoldAccentBrush}" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="Permanent per-account archive, FIFO matched profit, active order book health, and hour-of-day fills." Style="{StaticResource HintText}" Margin="0,3,0,0" />
                        </StackPanel>
                        <WrapPanel x:Name="IncomeHeaderActionsPanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <ComboBox x:Name="IncomeTimeframeSelector" SelectedIndex="2" MinWidth="128" Width="128" SelectionChanged="IncomeTimeframe_SelectionChanged" Margin="0,0,8,4">
                                <ComboBoxItem Content="Today" Tag="1" />
                                <ComboBoxItem Content="7 Days" Tag="7" />
                                <ComboBoxItem Content="30 Days" Tag="30" />
                                <ComboBoxItem Content="90 Days" Tag="90" />
                                <ComboBoxItem Content="All Time" Tag="0" />
                            </ComboBox>
                            <Button x:Name="SyncPortfolioButton" Content="Sync GW2 Account" Tag="&#xE895;" Style="{StaticResource PrimaryButton}" Click="SyncPortfolio_Click" Margin="0,0,8,4" />
                            <Button Content="Export Ledger CSV" Tag="&#xE74E;" Click="ExportLedgerCsv_Click" Margin="0,0,0,4" />
                        </WrapPanel>
                    </Grid>

                    <!-- Sync Status & Portfolio Advisor Insights Strip -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock x:Name="IncomeSyncStatusText" Text="Click 'Sync GW2 Account' after saving your API key in Settings to archive transactions and track equity." Style="{StaticResource HintText}" Margin="0,0,0,6" />
                        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource GlyphIcon}" FontSize="12" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,8,0" />
                                <TextBlock x:Name="PortfolioInsightsText" Text="Live Advisor ready — sync trades to unlock FIFO winner boosts &amp; chronic-loser guards." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 4 Portfolio KPI Cards -->
                    <UniformGrid x:Name="IncomeKpiGrid" Grid.Row="2" Columns="4" Margin="0,0,0,6">
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,8">
                            <StackPanel>
                                <TextBlock Text="REALIZED FLIP PROFIT (FIFO)" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="IncomeMatchedProfitText" Text="0c" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource GoldAccentBrush}" />
                                <TextBlock x:Name="IncomeMatchedSubText" Text="ROI: 0.0% • Win rate: 0% • Avg 0c/day" Style="{StaticResource HintText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,8">
                            <StackPanel>
                                <TextBlock Text="TOTAL TRADING EQUITY" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="IncomeTotalEquityText" Text="—" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" />
                                <TextBlock x:Name="IncomeEquityBreakdownText" Text="Sync account to snapshot Wallet + Buys + 90% Sells" Style="{StaticResource HintText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,8">
                            <StackPanel>
                                <TextBlock Text="DELIVERY BOX &amp; UNMATCHED" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="IncomeDeliveryText" Text="—" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock x:Name="IncomeUnmatchedText" Text="Unmatched loot/pre-sync sales: 0c" Style="{StaticResource HintText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource KpiCard}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="ACTIVE ORDERS HEALTH" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="IncomeOrdersHealthText" Text="0 open" FontSize="20" FontWeight="Bold" />
                                <TextBlock x:Name="IncomeOrdersSubText" Text="Top of book vs Outbid buys vs Undercut sells" Style="{StaticResource HintText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Interactive Charts Row -->
                    <Grid x:Name="IncomeChartsGrid" Grid.Row="3" Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="IncomeChartsLeftCol" Width="1.2*" />
                            <ColumnDefinition x:Name="IncomeChartsRightCol" Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Daily Realized Profit Chart -->
                        <Border x:Name="DailyProfitChartCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,12,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Daily Realized Profit" Style="{StaticResource FieldLabel}" Margin="0" TextTrimming="CharacterEllipsis" ToolTip="Hover bars for exact daily breakdown" />
                                    <TextBlock x:Name="DailyChartSummaryText" Grid.Column="1" Text="" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" Margin="8,0,0,0" />
                                </Grid>
                                <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="10,12,10,8" Height="132">
                                    <ItemsControl x:Name="DailyProfitChartItems">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ToolTip="{Binding Tooltip}" Margin="2,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Border Background="{Binding BarBrush}"
                                                            Height="{Binding BarHeight}"
                                                            VerticalAlignment="Bottom"
                                                            CornerRadius="3,3,0,0"
                                                            MinWidth="4"
                                                            MaxWidth="26" />
                                                    <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Local Hour-of-Day Activity Chart -->
                        <Border x:Name="HourlyActivityChartCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Padding="16,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Activity by Local Hour (00–23)" Style="{StaticResource FieldLabel}" Margin="0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="HourlyChartSummaryText" Grid.Column="1" Text="Local timezone" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" Margin="8,0,0,0" />
                                </Grid>
                                <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="10,12,10,8" Height="132">
                                    <ItemsControl x:Name="HourlyActivityChartItems">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ToolTip="{Binding Tooltip}" Margin="1,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Border Background="{Binding BarBrush}"
                                                            Height="{Binding BarHeight}"
                                                            VerticalAlignment="Bottom"
                                                            CornerRadius="3,3,0,0"
                                                            MinWidth="4" />
                                                    <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Tabbed Tables -->
                    <TabControl Grid.Row="4">
                        <TabItem Header="Item P&amp;L Leaderboard">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="Filter item:" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox x:Name="IncomeSearchBox" Width="220" TextChanged="IncomeSearchBox_TextChanged" ToolTip="Filter leaderboard by item name" />
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Content="Blacklist Selected" Tag="&#xE8F8;" Click="BlacklistSelectedPnlItem_Click" HorizontalAlignment="Right" />
                                </DockPanel>
                                <DataGrid x:Name="ItemPnlGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ITEM NAME" Binding="{Binding ItemName}" Width="2.1*" MinWidth="135" />
                                        <DataGridTextColumn Header="QTY" Binding="{Binding UnitsFlipped}" Width="0.6*" MinWidth="46" />
                                        <DataGridTextColumn Header="AVG BUY" Binding="{Binding AvgBuyFormatted}" Width="0.95*" MinWidth="75" />
                                        <DataGridTextColumn Header="AVG SELL" Binding="{Binding AvgSellFormatted}" Width="0.95*" MinWidth="75" />
                                        <DataGridTextColumn Header="NET PROFIT" Binding="{Binding NetProfitFormatted}" Width="1*" MinWidth="82" />
                                        <DataGridTextColumn Header="ROI" Binding="{Binding RoiFormatted}" Width="0.65*" MinWidth="54" />
                                        <DataGridTextColumn Header="HOLD" Binding="{Binding AvgHoldFormatted}" Width="0.65*" MinWidth="56" />
                                        <DataGridTextColumn Header="OUTCOME" Binding="{Binding OutcomeBadge}" Width="0.8*" MinWidth="72" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Active Orders">
                            <DataGrid x:Name="ActiveOrdersGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SIDE" Binding="{Binding Side}" Width="0.6*" />
                                    <DataGridTextColumn Header="ITEM NAME" Binding="{Binding ItemName}" Width="2.1*" />
                                    <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="0.55*" />
                                    <DataGridTextColumn Header="YOUR PRICE" Binding="{Binding YourPriceFormatted}" Width="1*" />
                                    <DataGridTextColumn Header="MARKET TOP" Binding="{Binding MarketTopFormatted}" Width="1*" />
                                    <DataGridTextColumn Header="BOOK STATUS" Binding="{Binding BookStatus}" Width="0.9*" />
                                    <DataGridTextColumn Header="CREATED" Binding="{Binding CreatedFormatted}" Width="1.1*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="Synced Ledger">
                            <DataGrid x:Name="LedgerHistoryGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PURCHASED" Binding="{Binding PurchasedFormatted}" Width="1.15*" />
                                    <DataGridTextColumn Header="SIDE" Binding="{Binding Side}" Width="0.55*" />
                                    <DataGridTextColumn Header="ITEM NAME" Binding="{Binding ItemName}" Width="2.1*" />
                                    <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="0.55*" />
                                    <DataGridTextColumn Header="UNIT PRICE" Binding="{Binding UnitPriceFormatted}" Width="1*" />
                                    <DataGridTextColumn Header="GROSS TOTAL" Binding="{Binding GrossTotalFormatted}" Width="1.05*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- ============================================================ -->
                <!-- VIEW 2B: TRADE SESSION REPORTS (ARCHIVE & AUDIT)             -->
                <!-- ============================================================ -->
                <Grid x:Name="ReportsView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header + Toolbar -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Session Reports" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Automatically archived run summaries, trade logs, character swaps, recovery incidents, and cap shutdown audits." Style="{StaticResource HintText}" Margin="0,3,0,0" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <ComboBox x:Name="ReportOutcomeFilterSelector" SelectedIndex="0" MinWidth="136" SelectionChanged="ReportOutcomeFilter_SelectionChanged" Margin="0,0,8,4">
                                <ComboBoxItem Content="All Reports" Tag="all" />
                                <ComboBoxItem Content="Completed &amp; Cap" Tag="completed" />
                                <ComboBoxItem Content="Issues / Recoveries" Tag="issues" />
                            </ComboBox>
                            <Button Content="Refresh" Tag="&#xE72C;" Click="RefreshReports_Click" Padding="11,6" FontSize="12" Margin="0,0,8,4" />
                            <Button x:Name="ExportReportMdButton" Content="Export MD" Tag="&#xE8A5;" Style="{StaticResource PrimaryButton}" Click="ExportReportMarkdown_Click" Padding="11,6" FontSize="12" Margin="0,0,8,4" />
                            <Button x:Name="ExportReportJsonButton" Content="Export JSON" Tag="&#xE74E;" Click="ExportReportJson_Click" Padding="11,6" FontSize="12" Margin="0,0,8,4" />
                            <Button x:Name="DeleteReportButton" Content="Delete" Tag="&#xE74D;" Click="DeleteReport_Click" Padding="11,6" FontSize="12" Margin="0,0,0,4" />
                        </WrapPanel>
                    </Grid>

                    <!-- Responsive Master-Detail Grid -->
                    <Grid x:Name="ReportsSplitGrid" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="ReportsTopRow" Height="*" />
                            <RowDefinition x:Name="ReportsBottomRow" Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ReportsLeftCol" Width="300" />
                            <ColumnDefinition x:Name="ReportsRightCol" Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Saved Reports Feed -->
                        <Border x:Name="ReportsListCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,14,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Margin="4,2,4,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SAVED SESSIONS" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ReportsCountText" Grid.Column="1" Text="0 reports" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <ListBox x:Name="SessionReportsListBox"
                                         Grid.Row="1"
                                         HorizontalContentAlignment="Stretch"
                                         SelectionChanged="SessionReportsListBox_SelectionChanged"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,8"
                                                    Margin="0,2">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="8" Height="8" Fill="{Binding OutcomeBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Outcome}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding DurationFormatted}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{DynamicResource GoldAccentBrush}" Margin="6,0,0,0" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding StartedFormatted}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding CompactStats}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Grid.Row="2"
                                        Content="Report Eligibility Rules..."
                                        Tag="&#xE713;"
                                        Click="CustomizeReportSettings_Click"
                                        Padding="10,5"
                                        FontSize="11.5"
                                        Margin="0,10,0,0" />
                            </Grid>
                        </Border>

                        <!-- Right: Report Detail Viewer -->
                        <Border x:Name="ReportDetailCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Padding="18">
                            <Grid>
                                <!-- Empty State -->
                                <StackPanel x:Name="ReportEmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                                    <TextBlock Text="&#xE9F9;" Style="{StaticResource GlyphIcon}" FontSize="32" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                    <TextBlock Text="No session report selected yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="ReportRulesSummaryText"
                                               Text="Reports save automatically for Live sessions that run >= 5 min, execute trades/swaps, or hit recovery errors."
                                               Style="{StaticResource HintText}"
                                               TextAlignment="Center"
                                               Margin="0,6,0,14" />
                                    <Button Content="Customize Report Rules in Settings" Tag="&#xE713;" Click="CustomizeReportSettings_Click" HorizontalAlignment="Center" />
                                </StackPanel>

                                <!-- Selected Report Content -->
                                <Grid x:Name="ReportDetailContentPanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Session Header Banner -->
                                    <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14,12"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border x:Name="ReportDetailOutcomeBadge"
                                                        Background="{DynamicResource AccentSoftBrush}"
                                                        CornerRadius="12"
                                                        Padding="10,3"
                                                        Margin="0,0,10,2">
                                                    <TextBlock x:Name="ReportDetailOutcomeText" Text="Completed" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                                <TextBlock x:Name="ReportDetailTitleText" Text="Account — Live • Balanced" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </WrapPanel>
                                            <TextBlock x:Name="ReportDetailMetaText" Text="Started — • Ended —" Style="{StaticResource HintText}" Margin="0,5,0,0" />
                                            <TextBlock x:Name="ReportDetailSummaryText" Text="" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 4 KPI Cards -->
                                    <UniformGrid x:Name="ReportDetailKpiGrid" Grid.Row="1" Columns="4" Margin="0,0,0,8">
                                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,6">
                                            <StackPanel>
                                                <TextBlock Text="DURATION &amp; CYCLES" Style="{StaticResource FieldLabel}" />
                                                <TextBlock x:Name="ReportKpiDurationText" Text="00:00:00" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock x:Name="ReportKpiCyclesText" Text="0 cycles • 0 evaluated" Style="{StaticResource HintText}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,6">
                                            <StackPanel>
                                                <TextBlock Text="TRADING ACTIVITY" Style="{StaticResource FieldLabel}" />
                                                <TextBlock x:Name="ReportKpiTradesText" Text="0 actions" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" />
                                                <TextBlock x:Name="ReportKpiTradeBreakdownText" Text="0B / 0S / 0 refreshes" Style="{StaticResource HintText}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,6">
                                            <StackPanel>
                                                <TextBlock Text="WALLET &amp; VOLUME" Style="{StaticResource FieldLabel}" />
                                                <TextBlock x:Name="ReportKpiVolumeText" Text="0c" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource GoldAccentBrush}" />
                                                <TextBlock x:Name="ReportKpiWalletText" Text="Wallet: — -> —" Style="{StaticResource HintText}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource KpiCard}" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="RELIABILITY &amp; SWAPS" Style="{StaticResource FieldLabel}" />
                                                <TextBlock x:Name="ReportKpiHealthText" Text="Clean" FontSize="17" FontWeight="Bold" />
                                                <TextBlock x:Name="ReportKpiSwapsText" Text="0 swaps • 0 pickups" Style="{StaticResource HintText}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <!-- Trades vs Incidents Tables -->
                                    <TabControl Grid.Row="2">
                                        <TabItem x:Name="ReportTradesTabItem" Header="Trade &amp; Action Log (0)">
                                            <DataGrid x:Name="ReportTradesGrid" AutoGenerateColumns="False" IsReadOnly="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="TIME" Binding="{Binding TimeFormatted}" Width="0.7*" MinWidth="72" />
                                                    <DataGridTextColumn Header="ACTION" Binding="{Binding ActionType}" Width="0.9*" MinWidth="92" />
                                                    <DataGridTextColumn Header="ITEM" Binding="{Binding ItemName}" Width="1.6*" MinWidth="120" />
                                                    <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="0.45*" MinWidth="44" />
                                                    <DataGridTextColumn Header="COINS" Binding="{Binding CoinsFormatted}" Width="0.85*" MinWidth="76" />
                                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="0.75*" MinWidth="72" />
                                                    <DataGridTextColumn Header="DETAILS" Binding="{Binding Details}" Width="1.5*" MinWidth="120" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                        <TabItem x:Name="ReportIncidentsTabItem" Header="Incidents &amp; Bugs (0)">
                                            <DataGrid x:Name="ReportIncidentsGrid" AutoGenerateColumns="False" IsReadOnly="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="TIME" Binding="{Binding TimeFormatted}" Width="0.7*" MinWidth="72" />
                                                    <DataGridTextColumn Header="SEVERITY" Binding="{Binding Severity}" Width="0.7*" MinWidth="72" />
                                                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="1.1*" MinWidth="105" />
                                                    <DataGridTextColumn Header="RECOVERED" Binding="{Binding RecoveredLabel}" Width="0.7*" MinWidth="74" />
                                                    <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="2.5*" MinWidth="180" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ============================================================ -->
                <!-- VIEW 3: BUILT-IN PROFITABLE ITEM FINDER (MARKET SCANNER)     -->
                <!-- ============================================================ -->
                <Grid x:Name="ScannerView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Market Scanner" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Discover liquid flips from the official GW2 API with wall-depth checks, presets, and cached instant re-filtering." Style="{StaticResource HintText}" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Filter & Preset Card -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,16">
                        <StackPanel>
                            <!-- Strategy Preset Strip -->
                            <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                                <TextBlock Text="PRESETS:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,4" />
                                <Button Content="Starter (&lt; 100g)" CommandParameter="Starter (&lt; 100g)" Click="ApplyScannerPreset_Click" Padding="10,5" FontSize="11.5" Margin="0,0,6,4" />
                                <Button Content="Balanced (100g–1k)" CommandParameter="Balanced (100g–1,000g)" Click="ApplyScannerPreset_Click" Padding="10,5" FontSize="11.5" Margin="0,0,6,4" />
                                <Button Content="High Capital (1k+)" CommandParameter="High Capital (1,000g+)" Click="ApplyScannerPreset_Click" Padding="10,5" FontSize="11.5" Margin="0,0,6,4" />
                                <Button Content="High-Volume Safe" CommandParameter="High-Volume Safe" Click="ApplyScannerPreset_Click" Padding="10,5" FontSize="11.5" Margin="0,0,10,4" />
                                <Button x:Name="AutoTuneScannerButton" Content="Auto-Tune from Wallet" Tag="&#xE9D9;" Click="AutoTuneForWallet_Click" Padding="10,5" FontSize="11.5" Margin="0,0,0,4" />
                            </WrapPanel>

                            <!-- Primary Clean 4-Column Responsive Filter Grid -->
                            <UniformGrid x:Name="ScannerCoreFiltersGrid" Columns="4" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,10,4">
                                    <TextBlock Text="MIN ROI %" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ScanMinRoiBox" Text="10" ToolTip="Must beat GW2 15% tax; 10–15% is standard." />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,4">
                                    <TextBlock Text="MAX BUY (G)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ScanMaxBuyGoldBox" Text="50" ToolTip="Maximum unit buy price in gold. Blank = no cap." />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,4">
                                    <TextBlock Text="CATEGORY" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ScanCategorySelector" SelectedIndex="0">
                                        <ComboBoxItem Content="All Categories" Tag="All" />
                                        <ComboBoxItem Content="Crafting Material" Tag="CraftingMaterial" />
                                        <ComboBoxItem Content="Upgrade (Runes/Sigils)" Tag="UpgradeComponent" />
                                        <ComboBoxItem Content="Consumable" Tag="Consumable" />
                                        <ComboBoxItem Content="Weapon" Tag="Weapon" />
                                        <ComboBoxItem Content="Armor" Tag="Armor" />
                                        <ComboBoxItem Content="Trinket" Tag="Trinket" />
                                        <ComboBoxItem Content="Bag" Tag="Bag" />
                                        <ComboBoxItem Content="Container" Tag="Container" />
                                        <ComboBoxItem Content="Gizmo" Tag="Gizmo" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,4">
                                    <TextBlock Text="SORT BY" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ScanSortSelector" SelectedIndex="0">
                                        <ComboBoxItem Content="Balanced Score" Tag="BalancedScore" />
                                        <ComboBoxItem Content="Net Profit" Tag="NetProfit" />
                                        <ComboBoxItem Content="ROI %" Tag="Roi" />
                                        <ComboBoxItem Content="Liquidity" Tag="Liquidity" />
                                    </ComboBox>
                                </StackPanel>
                            </UniformGrid>

                            <!-- Collapsible More Filters (De-clutters 9 rarely-changed controls) -->
                            <Expander x:Name="ScannerAdvancedExpander" IsExpanded="False" Margin="0,0,0,12" Padding="12,8" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}">
                                <Expander.Header>
                                    <TextBlock Text="More Filters (ROI cap, depth, rarity, scan scope &amp; walls)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </Expander.Header>
                                <StackPanel>
                                    <UniformGrid x:Name="ScannerAdvancedFiltersGrid" Columns="4" Margin="0,0,0,8">
                                        <StackPanel Margin="0,0,10,6">
                                            <TextBlock Text="MAX ROI %" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ScanMaxRoiBox" Text="120" ToolTip="Caps suspicious wide spreads that are often dead or manipulated. Blank = no cap." />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,6">
                                            <TextBlock Text="MIN PROFIT (S)" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ScanMinProfitSilverBox" Text="5" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,6">
                                            <TextBlock Text="MIN BUY (S)" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ScanMinBuySilverBox" Text="10" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="RARITY" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="ScanRaritySelector" SelectedIndex="0">
                                                <ComboBoxItem Content="All" Tag="All" />
                                                <ComboBoxItem Content="Fine" Tag="Fine" />
                                                <ComboBoxItem Content="Masterwork" Tag="Masterwork" />
                                                <ComboBoxItem Content="Rare" Tag="Rare" />
                                                <ComboBoxItem Content="Exotic" Tag="Exotic" />
                                                <ComboBoxItem Content="Ascended" Tag="Ascended" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,4">
                                            <TextBlock Text="MIN SUPPLY" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ScanMinSupplyBox" Text="100" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,4">
                                            <TextBlock Text="MIN DEMAND" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ScanMinDemandBox" Text="100" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,4">
                                            <TextBlock Text="SCAN SCOPE" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="ScanScopeSelector" SelectedIndex="1">
                                                <ComboBoxItem Content="Quick (2,000 items)" Tag="2000" />
                                                <ComboBoxItem Content="Standard (6,000 items)" Tag="6000" />
                                                <ComboBoxItem Content="Full Market (All)" Tag="0" />
                                            </ComboBox>
                                        </StackPanel>
                                        <Border />
                                    </UniformGrid>
                                    <WrapPanel Orientation="Horizontal">
                                        <CheckBox x:Name="ScanCheckWallsCheckBox" Content="Check order-book walls" IsChecked="True" Margin="0,0,20,4" ToolTip="Queries v2/commerce/listings on matches to catch sell walls and bait spreads." />
                                        <CheckBox x:Name="ScanVelocityCheckBox" Content="Include 24h Vol (DataWars2)" IsChecked="False" Margin="0,0,0,4" ToolTip="Optional external lookup from api.datawars2.ie for daily bought/sold estimates." />
                                    </WrapPanel>
                                </StackPanel>
                            </Expander>

                            <!-- Grouped Action Bar: Primary Scan/Session Actions vs Secondary List Actions -->
                            <DockPanel LastChildFill="True">
                                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button Content="Import CSV" Tag="&#xE8E5;" Click="ImportScannerFile_Click" Padding="10,6" FontSize="12" Margin="0,0,6,4" ToolTip="Import GW2BLTC / GW2Profits CSV or JSON" />
                                    <Button Content="Add to List" Tag="&#xE710;" Click="AddSelectedScanToCustomList_Click" Padding="10,6" FontSize="12" Margin="0,0,6,4" ToolTip="Add selected row to Custom Shopping List" />
                                    <Button Content="Blacklist Selected" Tag="&#xE8F8;" Click="BlacklistSelectedScanItem_Click" Padding="10,6" FontSize="12" Margin="0,0,0,4" />
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="ScanMarketButton" Content="Scan GW2 Market" Tag="&#xE721;" Style="{StaticResource PrimaryButton}" Click="ScanMarket_Click" Margin="0,0,8,4" />
                                    <Button x:Name="UseScanResultsButton" Content="Use All for Session" Tag="&#xE73E;" Style="{StaticResource SuccessButton}" Click="UseScanResultsForSession_Click" Margin="0,0,8,4" />
                                    <Button x:Name="ReFilterButton" Content="Re-Filter" Tag="&#xE71C;" Click="ReFilterCachedScan_Click" ToolTip="Instantly re-filter cached Trading Post prices without re-downloading." Margin="0,0,8,4" />
                                    <Button x:Name="CancelScanButton" Content="Cancel" Tag="&#xE711;" Click="CancelScan_Click" IsEnabled="False" Margin="0,0,12,4" />
                                </WrapPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Progress Bar -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="ScanProgressBar" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <TextBlock x:Name="ScanStatusText" Grid.Column="1" Text="Pick a preset or click Scan GW2 Market to find flips." Style="{StaticResource HintText}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Results DataGrid -->
                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                        <DataGrid x:Name="ScanResultsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="ToolTip" Value="{Binding FeeBreakdownTooltip}" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ITEM NAME" Binding="{Binding ItemName}" Width="2*" />
                                <DataGridTextColumn Header="TYPE" Binding="{Binding ItemType}" Width="1*" />
                                <DataGridTextColumn Header="RARITY" Binding="{Binding Rarity}" Width="0.75*" />
                                <DataGridTextColumn Header="HIGHEST BUY" Binding="{Binding BuyFormatted}" Width="0.9*" />
                                <DataGridTextColumn Header="LOWEST SELL" Binding="{Binding SellFormatted}" Width="0.9*" />
                                <DataGridTextColumn Header="NET PROFIT" Binding="{Binding ProfitFormatted}" Width="0.9*" />
                                <DataGridTextColumn Header="ROI" Binding="{Binding RoiFormatted}" Width="0.65*" />
                                <DataGridTextColumn Header="DEMAND" Binding="{Binding BuyQuantity}" Width="0.65*" />
                                <DataGridTextColumn Header="SUPPLY" Binding="{Binding SellQuantity}" Width="0.65*" />
                                <DataGridTextColumn Header="24H VOL" Binding="{Binding VolumeFormatted}" Width="0.7*" />
                                <DataGridTextColumn Header="SIGNAL" Binding="{Binding RiskBadge}" Width="0.8*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- ============================================================ -->
                <!-- VIEW 4: CUSTOM SHOPPING LIST & BLACKLIST EDITOR              -->
                <!-- ============================================================ -->
                <Grid x:Name="ListsView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Lists &amp; Blacklist" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Curate your custom flip targets and block items you never want evaluated. Saved automatically to your local profiles folder." Style="{StaticResource HintText}" Margin="0,3,0,0" />
                    </StackPanel>

                    <Grid x:Name="ListsSplitGrid" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="ListsTopRow" Height="*" />
                            <RowDefinition x:Name="ListsBottomRow" Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ListsLeftCol" Width="1.2*" />
                            <ColumnDefinition x:Name="ListsRightCol" Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Custom Shopping List Card -->
                        <Border x:Name="CustomListCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Clean Symmetric Header -->
                                <StackPanel Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE7BF;" Style="{StaticResource GlyphIcon}" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                                            <TextBlock Text="Custom Shopping List" Style="{StaticResource SectionTitle}" />
                                            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="CustomListCountText" Text="0 items" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Use for Session" Tag="&#xE73E;" Style="{StaticResource SuccessButton}" Height="30" MinHeight="30" Padding="10,0" FontSize="11.5" Click="UseCustomListForSession_Click" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Explicit flip targets evaluated in Live &amp; Dry run sessions." Style="{StaticResource HintText}" FontSize="11.5" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- Even 2-row Input Strip (34px height locked across every control) -->
                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="34" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.1*" MinWidth="120" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ITEM NAME" Style="{StaticResource FieldLabel}" Margin="0,0,8,5" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="RARITY" Style="{StaticResource FieldLabel}" Margin="0,0,8,5" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="QTY" Style="{StaticResource FieldLabel}" Margin="0,0,8,5" />

                                    <TextBox x:Name="CustomItemNameBox" Grid.Row="1" Grid.Column="0" Height="34" Margin="0,0,8,0" KeyDown="CustomItemInput_KeyDown" ToolTip="Exact Guild Wars 2 item name (press Enter to add)" />
                                    <ComboBox x:Name="CustomItemRaritySelector" Grid.Row="1" Grid.Column="1" Height="34" SelectedIndex="0" Margin="0,0,8,0">
                                        <ComboBoxItem Content="Basic" />
                                        <ComboBoxItem Content="Fine" />
                                        <ComboBoxItem Content="Masterwork" />
                                        <ComboBoxItem Content="Rare" />
                                        <ComboBoxItem Content="Exotic" />
                                        <ComboBoxItem Content="Ascended" />
                                    </ComboBox>
                                    <TextBox x:Name="CustomItemQtyBox" Grid.Row="1" Grid.Column="2" Height="34" Text="1" HorizontalContentAlignment="Center" Margin="0,0,8,0" KeyDown="CustomItemInput_KeyDown" ToolTip="Target order quantity" />
                                    <Button Grid.Row="1" Grid.Column="3" Content="Add" Tag="&#xE710;" Style="{StaticResource PrimaryButton}" Height="34" MinWidth="78" Padding="12,0" FontSize="12.5" Click="AddCustomItem_Click" />
                                </Grid>

                                <DataGrid x:Name="CustomShoppingListGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ITEM NAME" Binding="{Binding ItemName}" Width="2*" MinWidth="120" />
                                        <DataGridTextColumn Header="RARITY" Binding="{Binding Rarity}" Width="0.8*" MinWidth="70" />
                                        <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="0.5*" MinWidth="46" />
                                        <DataGridTextColumn Header="BUY (c)" Binding="{Binding BuyPriceCopper}" Width="0.75*" MinWidth="66" />
                                        <DataGridTextColumn Header="SELL (c)" Binding="{Binding SellPriceCopper}" Width="0.75*" MinWidth="66" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Remove" Tag="&#xE74D;" Click="RemoveCustomItem_Click" Height="34" Padding="12,0" FontSize="12" Margin="0,0,8,4" ToolTip="Remove selected item from Shopping List" />
                                    <Button Content="Import" Tag="&#xE8E5;" Click="ImportCustomList_Click" Height="34" Padding="12,0" FontSize="12" Margin="0,0,8,4" ToolTip="Import Shopping List from CSV or JSON" />
                                    <Button Content="Export CSV" Tag="&#xE74E;" Click="ExportCustomList_Click" Height="34" Padding="12,0" FontSize="12" Margin="0,0,0,4" ToolTip="Export Shopping List to CSV" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Blacklist Card -->
                        <Border x:Name="BlacklistCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Clean Symmetric Header -->
                                <StackPanel Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MinHeight="30">
                                        <TextBlock Text="&#xE8F8;" Style="{StaticResource GlyphIcon}" FontSize="16" Foreground="{DynamicResource DangerBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="Blacklisted Items" Style="{StaticResource SectionTitle}" />
                                        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="BlacklistCountText" Text="0 blocked" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Names or wildcards (*) skipped across Market Scanner &amp; live sessions." Style="{StaticResource HintText}" FontSize="11.5" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- Even 2-row Input Strip matching Custom Shopping List -->
                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="34" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="130" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="NAME OR WILDCARD (*)" Style="{StaticResource FieldLabel}" Margin="0,0,8,5" />
                                    <TextBox x:Name="BlacklistInputBox" Grid.Row="1" Grid.Column="0" Height="34" Margin="0,0,8,0" KeyDown="BlacklistInput_KeyDown" ToolTip="Item name or wildcard pattern (e.g. 'Recipe:*') — press Enter to block" />
                                    <Button Grid.Row="1" Grid.Column="1" Content="Block" Tag="&#xE710;" Style="{StaticResource DangerButton}" Height="34" MinWidth="82" Padding="12,0" FontSize="12.5" Click="AddBlacklistItem_Click" />
                                </Grid>

                                <Border Grid.Row="2" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="10,7">
                                            <TextBlock Text="ITEM NAME OR WILDCARD PATTERN" Style="{StaticResource FieldLabel}" Margin="0" />
                                        </Border>
                                        <ListBox x:Name="BlacklistListBox" Grid.Row="1" BorderThickness="0" Padding="4" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    </Grid>
                                </Border>

                                <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Remove" Tag="&#xE74D;" Click="RemoveBlacklistItem_Click" Height="34" Padding="12,0" FontSize="12" Margin="0,0,8,4" ToolTip="Remove selected entry from Blacklist" />
                                    <Button Content="Import" Tag="&#xE8E5;" Click="ImportBlacklist_Click" Height="34" Padding="12,0" FontSize="12" Margin="0,0,8,4" ToolTip="Import Blacklist from CSV, JSON, or TXT" />
                                    <Button Content="Export CSV" Tag="&#xE74E;" Click="ExportBlacklist_Click" Height="34" Padding="12,0" FontSize="12" Margin="0,0,0,4" ToolTip="Export Blacklist to CSV" />
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ============================================================ -->
                <!-- VIEW 5: SETTINGS (4 CLEAN SEGMENTED TABS)                    -->
                <!-- ============================================================ -->
                <Grid x:Name="SettingsView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Organized by workflow: API vault, ArenaNet vs. Steam client &amp; retries, strategy &amp; portfolio, and hotkeys." Style="{StaticResource HintText}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button x:Name="AutoTuneSettingsButton" Content="Auto-Tune for My Wallet" Tag="&#xE9D9;" Click="AutoTuneForWallet_Click" Margin="0,0,8,0" ToolTip="Reads active account wallet gold and applies safe proven trading defaults." />
                            <Button x:Name="SaveAllSettingsButton" Content="Save All Settings" Tag="&#xE74E;" Style="{StaticResource PrimaryButton}" Click="SaveAllSettings_Click" />
                        </StackPanel>
                    </DockPanel>

                    <TabControl x:Name="SettingsTabControl" Grid.Row="1">
                        <!-- TAB 1: ACCOUNTS & API -->
                        <TabItem Header="Accounts &amp; API">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                <StackPanel Margin="4">
                                    <DockPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8D7;" Style="{StaticResource GlyphIcon}" FontSize="16" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,9,0" />
                                            <TextBlock Text="Manage API Keys (Windows DPAPI Encrypted)" Style="{StaticResource SectionTitle}" />
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="SaveCustomNamesButton" Content="Save Custom Names" Tag="&#xE74E;" Padding="10,4" FontSize="11.5" Click="SaveCustomNames_Click" Margin="0,0,8,0" />
                                            <Button x:Name="ReverifyApiKeysButton" Content="Re-verify Keys" Tag="&#xE72C;" Padding="10,4" FontSize="11.5" Click="ReverifyApiKeys_Click" Margin="0,0,8,0" />
                                            <Button Content="Open ArenaNet API Keys" Tag="&#xE8A7;" Padding="10,4" FontSize="11.5" Click="OpenArenaNetApiKeys_Click" />
                                        </StackPanel>
                                    </DockPanel>

                                    <DataGrid x:Name="ApiKeysGrid"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              SelectionMode="Single"
                                              MaxHeight="220"
                                              Margin="0,0,0,14">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="ACTIVE" Width="84">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding UseLabel}"
                                                                CommandParameter="{Binding Id}"
                                                                IsEnabled="{Binding CanUse}"
                                                                Click="UseApiKey_Click"
                                                                Padding="8,3"
                                                                FontSize="11"
                                                                HorizontalAlignment="Stretch" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="ORDER" Width="74">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Button Content="&#x2191;"
                                                                    CommandParameter="{Binding Id}"
                                                                    IsEnabled="{Binding CanMoveUp}"
                                                                    Click="MoveApiKeyUp_Click"
                                                                    Padding="7,2"
                                                                    FontSize="11"
                                                                    Margin="0,0,4,0"
                                                                    ToolTip="Move up" />
                                                            <Button Content="&#x2193;"
                                                                    CommandParameter="{Binding Id}"
                                                                    IsEnabled="{Binding CanMoveDown}"
                                                                    Click="MoveApiKeyDown_Click"
                                                                    Padding="7,2"
                                                                    FontSize="11"
