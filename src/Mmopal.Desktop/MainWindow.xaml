<Window x:Class="Mmopal.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:pages="clr-namespace:Mmopal.Desktop.Pages"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mmopal — GW2 Companion"
        Icon="pack://application:,,,/Mmopal.Desktop;component/Assets/mmopal.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource AppBackgroundBrush}"
        Height="800" Width="1300" MinHeight="560" MinWidth="520"
        SizeChanged="Window_SizeChanged"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar Rail -->
        <Border x:Name="SidebarBorder"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16,20">
            <DockPanel LastChildFill="True">
                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="2,0,2,22">
                    <StackPanel x:Name="SidebarBrandRow" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="SidebarBrandIconBorder" Width="36" Height="36" CornerRadius="9" Background="#121C2E" BorderBrush="{DynamicResource GoldAccentBrush}" BorderThickness="1.5" Margin="0,0,11,0" ToolTip="Mmopal — GW2 Companion">
                            <Viewbox Width="23" Height="23" Stretch="Uniform">
                                <Canvas Width="256" Height="256">
                                    <Polygon Points="128,32 150,56 128,80 106,56" Fill="#4AA9FF" />
                                    <Line X1="128" Y1="88" X2="128" Y2="202" Stroke="#F0B94A" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Rectangle Canvas.Left="84" Canvas.Top="196" Width="88" Height="18" RadiusX="9" RadiusY="9" Fill="#F0B94A" />
                                    <Line X1="52" Y1="120" X2="204" Y2="96" Stroke="#F0B94A" StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Line X1="52" Y1="120" X2="34" Y2="168" Stroke="#F0B94A" StrokeThickness="9" />
                                    <Line X1="52" Y1="120" X2="70" Y2="168" Stroke="#F0B94A" StrokeThickness="9" />
                                    <Path Data="M 28,168 L 76,168 Q 52,198 28,168 Z" Fill="#F0B94A" />
                                    <Line X1="204" Y1="96" X2="186" Y2="144" Stroke="#F0B94A" StrokeThickness="9" />
                                    <Line X1="204" Y1="96" X2="222" Y2="144" Stroke="#F0B94A" StrokeThickness="9" />
                                    <Path Data="M 180,144 L 228,144 Q 204,174 180,144 Z" Fill="#F0B94A" />
                                    <Ellipse Canvas.Left="194" Canvas.Top="122" Width="20" Height="20" Fill="#4AA9FF" />
                                    <Ellipse Canvas.Left="114" Canvas.Top="95" Width="28" Height="28" Fill="#F0B94A" />
                                    <Ellipse Canvas.Left="121" Canvas.Top="102" Width="14" Height="14" Fill="#121C2E" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel x:Name="SidebarBrandText" VerticalAlignment="Center">
                            <TextBlock Text="MMOPAL" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="GW2 COMPANION" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Footer: Theme + Status + Hotkey Hint -->
                <StackPanel x:Name="SidebarFooterPanel" DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Border x:Name="SidebarStatusBorder"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="12,10"
                            Margin="0,0,0,12"
                            ToolTip="Status: Ready (Offline)">
                        <StackPanel x:Name="SidebarStatusStack">
                            <StackPanel x:Name="SidebarStatusRow" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="SidebarStatusDot" Fill="{DynamicResource SuccessBrush}" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="SidebarStatusLabel" Text="Ready (Offline)" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock x:Name="SidebarHotkeyHint" Text="Pause: Ctrl+Shift+P  •  Stop: Ctrl+Shift+S" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="SidebarFooterExpanded">
                        <TextBlock Text="ACTIVE ACCOUNT" Style="{StaticResource FieldLabel}" Margin="2,0,0,4" />
                        <ComboBox x:Name="SidebarAccountSelector" SelectionChanged="SidebarAccountSelector_SelectionChanged" Margin="0,0,0,10" />

                        <TextBlock Text="APPEARANCE" Style="{StaticResource FieldLabel}" Margin="2,0,0,4" />
                        <ComboBox x:Name="ThemeSelector" SelectedIndex="0" SelectionChanged="ThemeSelector_SelectionChanged">
                            <ComboBoxItem Content="System" />
                            <ComboBoxItem Content="Dark" />
                            <ComboBoxItem Content="Light" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Items -->
                <StackPanel>
                    <TextBlock x:Name="SidebarWorkspaceLabel" Text="WORKSPACE" Style="{StaticResource FieldLabel}" Margin="6,0,0,6" />
                    <RadioButton x:Name="NavSession" Style="{StaticResource NavButton}" GroupName="Nav" IsChecked="True" Checked="Nav_Checked" ToolTip="Session Control Room">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource GlyphIcon}" FontSize="15" Margin="0,0,11,0" />
                            <TextBlock x:Name="NavSessionLabel" Text="Session" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavIncome" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked" ToolTip="Income &amp; Portfolio">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" Style="{StaticResource GlyphIcon}" FontSize="15" Margin="0,0,11,0" />
                            <TextBlock x:Name="NavIncomeLabel" Text="Income &amp; Portfolio" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavReports" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked" ToolTip="Session Reports">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F9;" Style="{StaticResource GlyphIcon}" FontSize="15" Margin="0,0,11,0" />
                            <TextBlock x:Name="NavReportsLabel" Text="Session Reports" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavScanner" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked" ToolTip="Market Scanner">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource GlyphIcon}" FontSize="15" Margin="0,0,11,0" />
                            <TextBlock x:Name="NavScannerLabel" Text="Market Scanner" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavLists" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked" ToolTip="Lists &amp; Blacklist">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" Style="{StaticResource GlyphIcon}" FontSize="15" Margin="0,0,11,0" />
                            <TextBlock x:Name="NavListsLabel" Text="Lists &amp; Blacklist" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked" ToolTip="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource GlyphIcon}" FontSize="15" Margin="0,0,11,0" />
                            <TextBlock x:Name="NavSettingsLabel" Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavGuide" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked" ToolTip="Guide &amp; Setup">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE897;" Style="{StaticResource GlyphIcon}" FontSize="15" Margin="0,0,11,0" />
                            <TextBlock x:Name="NavGuideLabel" Text="Guide &amp; Setup" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Border x:Name="MainContentBorder" Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}" Padding="24,20">
            <Grid>

                <!-- ============================================================ -->
                <!-- VIEW 1: SESSION DASHBOARD                                    -->
                <!-- ============================================================ -->
                <pages:SessionPage x:Name="SessionPage" />

                <!-- ============================================================ -->
                <!-- VIEW 2: INCOME & PORTFOLIO TRACKER                           -->
                <!-- ============================================================ -->
                <pages:IncomePage x:Name="IncomePage" />

                <!-- ============================================================ -->
                <!-- VIEW 2B: TRADE SESSION REPORTS (ARCHIVE & AUDIT)             -->
                <!-- ============================================================ -->
                <pages:ReportsPage x:Name="ReportsPage" />

                <!-- ============================================================ -->
                <!-- VIEW 3: BUILT-IN PROFITABLE ITEM FINDER (MARKET SCANNER)     -->
                <!-- ============================================================ -->
                <pages:ScannerPage x:Name="ScannerPage" />

                <!-- ============================================================ -->
                <!-- VIEW 4: CUSTOM SHOPPING LIST & BLACKLIST EDITOR              -->
                <!-- ============================================================ -->
                <pages:ListsPage x:Name="ListsPage" />

                <!-- ============================================================ -->
                <!-- VIEW 5: SETTINGS (4 CLEAN SEGMENTED TABS)                    -->
                <!-- ============================================================ -->
                <pages:SettingsPage x:Name="SettingsPage" />

                <!-- ============================================================ -->
                <!-- VIEW 6: GUIDE & PRE-FLIGHT SETUP                             -->
                <!-- ============================================================ -->
                <pages:GuidePage x:Name="GuidePage" />
            </Grid>
        </Border>
    </Grid>
</Window>
