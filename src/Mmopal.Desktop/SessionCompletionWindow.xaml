<Window x:Class="Mmopal.Desktop.SessionCompletionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mmopal — Session Cap Reached"
        Width="470"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource AppBackgroundBrush}">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="14"
            Padding="22,20">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0">
                    <TextBlock x:Name="ModeIconText"
                               Text="&#xE7E8;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{DynamicResource WarningBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeadlineText"
                               Text="Max Session Duration Reached"
                               FontSize="17"
                               FontWeight="Bold" />
                    <TextBlock x:Name="SubheadlineText"
                               Text="Trade session finalized and saved safely."
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <Border Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="14,12"
                    Margin="0,4,0,14">
                <StackPanel>
                    <TextBlock x:Name="BodyMessageText"
                               Text="Guild Wars 2 was closed cleanly. Automated action will run when the countdown reaches zero unless cancelled."
                               FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,6" VerticalAlignment="Center">
                        <TextBlock Text="Time remaining:"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock x:Name="CountdownSecondsText"
                                   Text="60s"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource GoldAccentBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ProgressBar x:Name="CountdownProgressBar"
                                 Height="7"
                                 Minimum="0"
                                 Maximum="60"
                                 Value="60"
                                 Foreground="{DynamicResource WarningBrush}"
                                 Background="{DynamicResource AppBackgroundBrush}" />
                </StackPanel>
            </Border>

            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Cancel Shutdown"
                        IsCancel="True"
                        Click="Cancel_Click"
                        Margin="0,0,8,0" />
                <Button x:Name="CloseAppOnlyButton"
                        Content="Close App Only"
                        Click="CloseAppOnly_Click"
                        Margin="0,0,8,0" />
                <Button x:Name="ExecuteNowButton"
                        Content="Shut Down Now"
                        Style="{StaticResource DangerButton}"
                        Click="ExecuteNow_Click" />
            </WrapPanel>
        </StackPanel>
    </Border>
</Window>
