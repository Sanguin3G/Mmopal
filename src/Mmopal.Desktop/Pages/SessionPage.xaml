<UserControl x:Class="Mmopal.Desktop.Pages.SessionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="SessionView" Visibility="Visible">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Session Control Room" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SessionSubtitleText" Text="Supervise your trading worker, snap Guild Wars 2 to 1024x768, and monitor live health." Style="{StaticResource HintText}" Margin="0,3,0,0" />
            </StackPanel>
            <WrapPanel x:Name="SessionHeaderPills" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Border x:Name="SessionClockPillBorder"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="8,3"
                        Margin="0,0,6,4"
                        ToolTip="Elapsed time for the current trade session">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SessionClockIcon" Text="&#xE916;" Style="{StaticResource GlyphIcon}" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="SessionClockText" Text="00:00:00" FontFamily="Segoe UI" FontSize="11.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border x:Name="MarketCyclePillBorder"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="8,3"
                        Margin="0,0,6,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE823;" Style="{StaticResource GlyphIcon}" FontSize="11" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,5,0" />
                        <TextBlock x:Name="MarketCyclePillText" Text="TP cycle" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border x:Name="SafeModePillBorder"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="8,3"
                        Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SafeModePillIcon" Text="&#xE72E;" Style="{StaticResource GlyphIcon}" FontSize="11" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,5,0" />
                        <TextBlock x:Name="SafeModePillText" Text="Safe · No input" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Grid>

        <!-- Setup Readiness Banner -->
        <Border x:Name="ReadinessBanner"
                Grid.Row="1"
                Background="{DynamicResource AccentSoftBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,0,0,14">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Open Guide &amp; Setup" Tag="&#xE897;" Style="{StaticResource PrimaryButton}" Padding="11,6" Click="OpenGuide_Click" Margin="0,0,8,0" />
                    <Button Content="Dismiss" Padding="10,6" Click="DismissReadinessBanner_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE946;" Style="{StaticResource GlyphIcon}" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                    <TextBlock x:Name="ReadinessBannerText" Text="Checking setup readiness..." FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Session Setup Card (Clean 3-Zone Control Layout) -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,12">
            <StackPanel>
                <!-- Zone 1: Core Selectors -->
                <UniformGrid x:Name="SessionSelectorsGrid" Columns="4">
                    <StackPanel Margin="0,0,10,6">
                        <TextBlock Text="ACTIVITY" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="BotSelector" SelectedIndex="0">
                            <ComboBoxItem Content="Trading Post" Tag="TradingPost" />
                            <ComboBoxItem Content="Fishing" Tag="Fishing" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,6">
                        <TextBlock Text="RUN MODE" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ModeSelector" SelectedIndex="0" SelectionChanged="ModeSelector_SelectionChanged">
                            <ComboBoxItem Content="Dry run" Tag="DryRun" />
                            <ComboBoxItem Content="Observe only" Tag="Observe" />
                            <ComboBoxItem Content="Live (Armed trading)" Tag="Live" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,6">
                        <TextBlock Text="PACE" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ProfileSelector" SelectedIndex="1" SelectionChanged="ProfileSelector_SelectionChanged">
                            <ComboBoxItem x:Name="PaceSafeItem" Content="Safe" Tag="safe" />
                            <ComboBoxItem x:Name="PaceBalancedItem" Content="Balanced" Tag="balanced" />
                            <ComboBoxItem x:Name="PaceFastItem" Content="Fast" Tag="fast" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="DATA SOURCE" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="SourceSelector" SelectedIndex="0" SelectionChanged="SourceSelector_SelectionChanged" ToolTip="Live mode always uses Screen observe; choosing Replay data switches Live back to Dry run.">
                            <ComboBoxItem Content="Replay data" Tag="replay" />
                            <ComboBoxItem Content="Screen observe" Tag="screen" />
                        </ComboBox>
                    </StackPanel>
                </UniformGrid>

                <!-- Pace details live in the Pace tooltips; kept (collapsed) for the summary text. -->
                <TextBlock x:Name="SessionPaceSummaryText" Visibility="Collapsed" />

                <!-- Transport, safety interlocks and client tools (icon buttons with tooltips) in one row. -->
                <DockPanel Margin="0,4,0,0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,4">
                        <Button x:Name="LaunchSnapButton" Tag="&#xE7F4;" Style="{StaticResource IconButton}" Click="LaunchSnapGw2_Click" Margin="0,0,4,0" ToolTip="Launch &amp; snap GW2: launches Guild Wars 2 (ArenaNet or Steam) and snaps its window to (0, 0) at 1024x768." />
                        <Button x:Name="SwapCharacterNowButton" Tag="&#xE77B;" Style="{StaticResource IconButton}" Click="SwapCharacterNow_Click" Margin="0,0,4,0" ToolTip="Swap character now, using your swap settings (requires Arm live input)." />
                        <Button x:Name="DockToggleButton" Tag="&#xE8A7;" Style="{StaticResource IconButton}" Click="DockToggle_Click" Margin="0,0,4,0" ToolTip="Dock beside GW2: fits Mmopal next to the 1024x768 game window, or restores your size." />
                        <Button x:Name="TryOfflineButton" Tag="&#xE9D9;" Style="{StaticResource IconButton}" Click="TryOfflineSample_Click" ToolTip="Try offline sample: simulates one Trading Post decision without GW2." />
                    </StackPanel>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="StartSessionButton" Content="Start session" Tag="&#xE768;" Style="{StaticResource PrimaryButton}" Click="Start_Click" Margin="0,0,8,4" />
                        <Button x:Name="PauseSessionButton" Content="Pause" Tag="&#xE769;" Click="Pause_Click" IsEnabled="False" Margin="0,0,8,4" ToolTip="Pause between steps; Resume continues where it left off." />
                        <Button x:Name="ResumeSessionButton" Content="Resume" Tag="&#xE72A;" Click="Resume_Click" IsEnabled="False" Margin="0,0,8,4" />
                        <Button x:Name="StopSessionButton" Content="Stop" Tag="&#xE71A;" Click="Stop_Click" IsEnabled="False" Margin="0,0,8,4" ToolTip="Finish the current step (an order being typed, a listing), then stop and save the session report." />
                        <Button x:Name="EmergencyStopButton" Content="Emergency stop" Tag="&#xE7BA;" Style="{StaticResource DangerButton}" Click="EmergencyStop_Click" IsEnabled="False" Margin="0,0,14,4" ToolTip="Stop instantly, even in the middle of an action. Use Stop for a normal end." />
                        <CheckBox x:Name="ArmLiveInputCheckBox" Content="Arm live input" IsChecked="False" Checked="ArmLiveInput_Changed" Unchecked="ArmLiveInput_Changed" VerticalAlignment="Center" Margin="0,0,14,4" ToolTip="Safety interlock: allows real mouse/keyboard input in Live mode." />
                        <CheckBox x:Name="AutoSellInventoryCheckBox" Content="Auto-list bought items" IsChecked="False" Checked="AutoSellInventory_Changed" Unchecked="AutoSellInventory_Changed" VerticalAlignment="Center" Margin="0,0,0,4" ToolTip="Lists only items Mmopal bought: items it placed buy orders for in the last 30 days and the current shopping list. Other bag items are never touched. Needs an API key with the characters and inventories permissions." />
                    </WrapPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Health KPI Row -->
        <!-- KPI cards: one large value to read at a glance, a short muted detail line, full text in tooltips. -->
        <StackPanel Grid.Row="3">
        <!-- Startup steps: what Mmopal did by itself when it opened (shown only when launch automation runs). -->
        <Border x:Name="LaunchStepsStrip" Visibility="Collapsed" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10" ToolTip="What Mmopal did by itself on launch. ○ waiting · … running · ✓ done · – skipped · ! failed. Change in Settings → Trading &amp; Portfolio.">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="STARTUP" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock x:Name="LaunchSyncText" Text="○ Account sync" FontSize="12" Margin="0,0,18,0" VerticalAlignment="Center" />
                <TextBlock x:Name="LaunchTuneText" Text="○ Auto-Tune" FontSize="12" Margin="0,0,18,0" VerticalAlignment="Center" />
                <TextBlock x:Name="LaunchScanText" Text="○ Market scan" FontSize="12" VerticalAlignment="Center" />
            </WrapPanel>
        </Border>
        <UniformGrid x:Name="SessionKpiGrid" Columns="4" Margin="0,0,0,6">
            <Border x:Name="StatusCard" Style="{StaticResource KpiCard}" Margin="0,0,10,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="&#xE9D2;" Style="{StaticResource GlyphIcon}" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0" />
                        <TextBlock Text="STATUS" Style="{StaticResource FieldLabel}" Margin="0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusStateDot" Width="9" Height="9" Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,1,8,0" />
                        <TextBlock x:Name="StatusStateText" Text="Idle" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="Idle — waiting for a session" Style="{StaticResource HintText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxHeight="34" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border x:Name="GameCard" Style="{StaticResource KpiCard}" Margin="0,0,10,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="&#xE7FC;" Style="{StaticResource GlyphIcon}" FontSize="13" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,7,0" />
                        <TextBlock Text="GAME" Style="{StaticResource FieldLabel}" Margin="0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock x:Name="GameHeadlineText" Text="—" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="ObservationSourceText" Text="No source yet" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ObservationUiText" Text="" Style="{StaticResource HintText}" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="OrdersCard" Style="{StaticResource KpiCard}" Margin="0,0,10,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="&#xE8D4;" Style="{StaticResource GlyphIcon}" FontSize="13" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,7,0" />
                        <TextBlock Text="ORDERS" Style="{StaticResource FieldLabel}" Margin="0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock x:Name="OrdersHeadlineText" Text="—" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource GoldAccentBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="OrdersDetailText" Text="No orders reported" Style="{StaticResource HintText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ObservationPriceText" Text="-" Visibility="Collapsed" />
                    <TextBlock x:Name="ObservationOrdersText" Text="No orders reported" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border x:Name="ScheduleCard" Style="{StaticResource KpiCard}" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="&#xE823;" Style="{StaticResource GlyphIcon}" FontSize="13" Foreground="{DynamicResource WarningBrush}" Margin="0,0,7,0" />
                        <TextBlock Text="SCHEDULE" Style="{StaticResource FieldLabel}" Margin="0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock x:Name="ScheduleHeadlineText" Text="No AFK swap" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SessionCapStatusText" Text="Session cap: 10h" Style="{StaticResource HintText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ObservationTimingText" Text="" Style="{StaticResource HintText}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AfkSwapStatusText" Text="AFK swap disabled" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </UniformGrid>
        <!-- Market list & history strip: what the bot is trading from and what it has learned. -->
        <Border x:Name="MarketIntelStrip" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="&#xE721;" Style="{StaticResource GlyphIcon}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="MarketListStatusText" Text="Shopping list: not started" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,18,0" VerticalAlignment="Center" ToolTip="Session shopping list size and the next automatic Market Scanner re-scan (Market Scanner → Advanced → Auto re-scan)." />
                <TextBlock Text="&#xE9D9;" Style="{StaticResource GlyphIcon}" FontSize="12" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="PortfolioStatusText" Text="History: —" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" ToolTip="Your last 30 days of trades (Income &amp; Portfolio): proven winners are boosted, items that lost money are skipped. Synced automatically every 45 minutes during a session." />
            </WrapPanel>
        </Border>
        </StackPanel>

        <!-- Activity Log Card -->
        <Border Grid.Row="4" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="&#xE756;" Style="{StaticResource GlyphIcon}" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0" />
                        <TextBlock Text="Activity Log" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="LogCountText" Text="0 events" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <CheckBox x:Name="ShowRawLogCheckBox" Content="Raw JSON" IsChecked="False" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="Clear" Tag="&#xE74D;" Click="ClearLog_Click" Padding="10,5" FontSize="12" />
                    </StackPanel>
                </DockPanel>
                <ListBox x:Name="LogList" Grid.Row="1" Margin="0,10,0,0"
                         FontFamily="Cascadia Mono, Consolas, Segoe UI"
                         FontSize="11.5"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <!-- Tight rows that wrap: more of the log fits, and long lines do not scroll sideways. -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="4,1" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
