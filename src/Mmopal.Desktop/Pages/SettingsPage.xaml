<UserControl x:Class="Mmopal.Desktop.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="SettingsView" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                <TextBlock Text="API keys, game client &amp; recovery, trading strategy, hotkeys." Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AutoTuneSettingsButton" Content="Auto-Tune" Tag="&#xE9D9;" Click="AutoTuneForWallet_Click" Margin="0,0,8,0" ToolTip="Auto-Tune: sizes max buy price, gold reserve, order size, overbid/undercut and scanner filters from your total gold and your last 14 days of flips. Runs by itself at launch and Start session (Settings → Trading &amp; Portfolio). Session cap and swap interval are left as you set them." />
                <Button x:Name="SaveAllSettingsButton" Content="Save All" Tag="&#xE74E;" Style="{StaticResource PrimaryButton}" Click="SaveAllSettings_Click" ToolTip="Save all settings" />
            </StackPanel>
        </Grid>

        <TabControl x:Name="SettingsTabControl" Grid.Row="1">
            <!-- TAB 1: ACCOUNTS & API -->
            <TabItem Header="Accounts &amp; API">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel Margin="4">
                        <StackPanel Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8D7;" Style="{StaticResource GlyphIcon}" FontSize="16" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,9,0" />
                                <TextBlock Text="API Keys" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Encrypted with Windows DPAPI" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,2,0,0" />
                            </StackPanel>
                            <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="ReverifyApiKeysButton" Content="Re-verify all" Tag="&#xE72C;" Style="{StaticResource CompactButton}" Click="ReverifyApiKeys_Click" Margin="0,0,8,4" ToolTip="Re-check every stored key against the GW2 API." />
                                <Button x:Name="TestApiKeyButton" Content="Test active" Tag="&#xE9D9;" Style="{StaticResource CompactButton}" Click="TestApiKey_Click" Margin="0,0,8,4" ToolTip="Check the active key and read its wallet." />
                                <Button Content="ArenaNet key page" Tag="&#xE8A7;" Style="{StaticResource CompactButton}" Click="OpenArenaNetApiKeys_Click" Margin="0,0,0,4" ToolTip="Open the ArenaNet applications page to create a key." />
                            </WrapPanel>
                        </StackPanel>

                        <DataGrid x:Name="ApiKeysGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  MaxHeight="220"
                                  Margin="0,0,0,14">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="ACTIVE" Width="76">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding UseLabel}"
                                                    CommandParameter="{Binding Id}"
                                                    IsEnabled="{Binding CanUse}"
                                                    Click="UseApiKey_Click"
                                                    Style="{StaticResource CompactButton}"
                                                    Margin="0,2"
                                                    HorizontalAlignment="Stretch" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="ORDER" Width="64">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Tag="&#xE70E;"
                                                        CommandParameter="{Binding Id}"
                                                        IsEnabled="{Binding CanMoveUp}"
                                                        Click="MoveApiKeyUp_Click"
                                                        Style="{StaticResource IconButton}"
                                                        Margin="0,2,4,2"
                                                        ToolTip="Move up" />
                                                <Button Tag="&#xE70D;"
                                                        CommandParameter="{Binding Id}"
                                                        IsEnabled="{Binding CanMoveDown}"
                                                        Click="MoveApiKeyDown_Click"
                                                        Style="{StaticResource IconButton}"
                                                        Margin="0,2"
                                                        ToolTip="Move down" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="STATUS" Width="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusText}"
                                                       Foreground="{Binding StatusBrush}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ACCOUNT" Binding="{Binding AccountName}" Width="*" MinWidth="110" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="NAME" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding CustomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="28"
                                                     Padding="6,0"
                                                     FontSize="12"
                                                     VerticalContentAlignment="Center"
                                                     Margin="0,2,6,2"
                                                     LostFocus="ApiKeyName_LostFocus"
                                                     KeyDown="ApiKeyName_KeyDown"
                                                     ToolTip="Your label for this account (e.g. Main EU). Saved when you press Enter or click elsewhere." />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="PLATFORM" Binding="{Binding PlatformLabel}" Width="80" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="API KEY" Width="196">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding MaskedKey}" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11.5" Margin="0,0,6,0" />
                                                <Button Grid.Column="1"
                                                        Tag="&#xE8C8;"
                                                        CommandParameter="{Binding Id}"
                                                        Click="CopyApiKey_Click"
                                                        Style="{StaticResource IconButton}"
                                                        Margin="0,2"
                                                        ToolTip="Copy API key" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Tag="&#xE74D;"
                                                    CommandParameter="{Binding Id}"
                                                    Click="DeleteApiKey_Click"
                                                    Style="{StaticResource IconButton}"
                                                    Margin="0,2"
                                                    ToolTip="Delete this key" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="ADD A KEY" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="API key" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3" />
                            <TextBlock Grid.Column="1" Text="Name (optional)" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3" />
                            <PasswordBox x:Name="ApiKeyPasswordBox" Grid.Row="1" Height="30" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="Paste an ArenaNet API key with account, tradingpost, wallet, inventories and characters." />
                            <TextBox x:Name="ApiKeyCustomNameBox" Grid.Row="1" Grid.Column="1" Height="30" Padding="6,1" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Optional label, e.g. Main EU or Steam Alt." />
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="SaveApiKeyButton" Content="Save &amp; verify" Tag="&#xE72E;" Style="{StaticResource PrimaryButton}" Click="SaveApiKey_Click" Margin="0,0,8,0" />
                                <Button x:Name="ClearApiKeyButton" Tag="&#xE74D;" Style="{StaticResource IconButton}" Click="ClearApiKey_Click" ToolTip="Remove the active key" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Scopes: account, tradingpost, wallet, inventories, characters." FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
                        <TextBlock x:Name="ApiKeyStatusText" Text="No API key stored yet. Recommended scopes: account, tradingpost, wallet, inventories, characters." Style="{StaticResource HintText}" Margin="0,0,0,10" />

                        <Expander IsExpanded="False" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="12,8">
                            <Expander.Header>
                                <TextBlock Text="Quick Setup Steps (ArenaNet Key Scopes &amp; Multi-Account Tip)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="1. Click 'ArenaNet Key Page' -> New Key and check: account, tradingpost, wallet, inventories, characters (characters+inventories enable bag-aware smart auto-sell)." Style="{StaticResource HintText}" />
                                <TextBlock Text="2. Paste the key above, give it a nickname, and click Save &amp; Verify Key." Style="{StaticResource HintText}" Margin="0,4,0,0" />
                                <TextBlock Text="3. Each saved account remembers its Launch Platform (ArenaNet vs Steam) when switched." Style="{StaticResource HintText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: GW2 CLIENT & RECOVERY -->
            <TabItem Header="GW2 Client &amp; Recovery">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel Margin="4">
                        <!-- Platform & Client -->
                        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource GlyphIcon}" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Launch Platform &amp; Window" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="2.1*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="LAUNCH PLATFORM" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="LaunchPlatformSelector" SelectedIndex="0" SelectionChanged="LaunchPlatformSelector_SelectionChanged" ToolTip="Choose ArenaNet standalone launcher (clicks LOG IN) or Steam (auto-login via steam://rungameid/1284210).">
                                            <ComboBoxItem Content="ArenaNet Launcher (Gw2-64.exe)" Tag="ArenaNet" />
                                            <ComboBoxItem Content="Steam (Auto-Login · App 1284210)" Tag="Steam" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="GW2 EXECUTABLE PATH (OR STEAM:// URI)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="Gw2ExecutablePathBox" ToolTip="Path to Gw2-64.exe or steam://rungameid/1284210" />
                                    </StackPanel>
                                    <Button x:Name="DetectGw2Button" Grid.Column="2" Content="Detect" Tag="&#xE721;" Click="DetectGw2_Click" VerticalAlignment="Bottom" Margin="0,0,8,0" />
                                    <Button Grid.Column="3" Content="Browse" Tag="&#xE8E5;" Click="BrowseGw2_Click" VerticalAlignment="Bottom" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="0.7*" />
                                        <ColumnDefinition Width="0.7*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="STANDALONE LAUNCH ARGUMENTS" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="Gw2LaunchArgsBox" Text="-autologin -windowed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="WIDTH" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="Gw2WidthBox" Text="1024" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="HEIGHT" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="Gw2HeightBox" Text="768" />
                                    </StackPanel>
                                </Grid>

                                <WrapPanel>
                                    <CheckBox x:Name="SnapWindowOnStartCheckBox" Content="Auto-snap GW2 to 1024x768 at (0, 0) on start" IsChecked="True" Margin="0,0,18,4" />
                                    <CheckBox x:Name="AutoLaunchGw2CheckBox" Content="Auto-launch GW2 if not running" Margin="0,0,18,4" />
                                    <CheckBox x:Name="AutoDockBesideGw2CheckBox" Content="Auto-dock Mmopal beside GW2 when running" IsChecked="True" Margin="0,0,0,4" ToolTip="Shrinks Mmopal cleanly next to the 1024x768 GW2 window while active so both stay visible, then restores size when stopped." />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Auto-Recovery & Bounded Restarts -->
                        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource GlyphIcon}" FontSize="15" Foreground="{DynamicResource WarningBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Auto-Recovery &amp; Bounded Restarts" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                                <TextBlock Text="Handles TP unreachable errors, disconnect kicks to Character Select, and stuck modals before halting." Style="{StaticResource HintText}" Margin="0,0,0,10" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="RECOVERY RETRIES" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="MaxRecoveryRetriesBox" Text="3" ToolTip="In-place recovery retries (0–10) for Character Select / TP / Esc before restarting or stopping." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="MAX GAME RESTARTS" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="MaxGameRestartsBox" Text="2" ToolTip="Maximum full GW2 restarts per session (0–5) when in-place retries cannot recover." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="MAX LAUNCH TRIES" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="MaxLaunchAttemptsBox" Text="2" ToolTip="Bounded launch attempts (1–5) before halting safely." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="WINDOW WAIT (S)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="WindowWaitSecondsBox" Text="45" ToolTip="Seconds to wait for the game window per launch attempt." />
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="AutoRestartOnFailureCheckBox" Content="Restart Guild Wars 2 automatically if in-place recovery retries fail (respects Auto-Play &amp; Steam mode)" IsChecked="True" />
                            </StackPanel>
                        </Border>

                        <!-- Network & High Ping -->
                        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE968;" Style="{StaticResource GlyphIcon}" FontSize="15" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Network Latency &amp; UI Timing" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="LATENCY PROFILE" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="LatencyProfileSelector" SelectedIndex="2" SelectionChanged="LatencyProfileSelector_SelectionChanged">
                                            <ComboBoxItem Content="Low (&lt; 80 ms)" Tag="Low" />
                                            <ComboBoxItem Content="Normal (80–160 ms)" Tag="Normal" />
                                            <ComboBoxItem Content="High Ping (200–300 ms · VN-&gt;EU)" Tag="HighPing" />
                                            <ComboBoxItem Content="Custom" Tag="Custom" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="TP UI LOAD WAIT (MS)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="UiLoadWaitMsBox" Text="7500" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="ACTION SETTLE (MS)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ActionSettleDelayMsBox" Text="900" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="API TIMEOUT (S)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ApiTimeoutSecondsBox" Text="60" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <StackPanel Width="320">
                                        <TextBlock Text="PRICE ENTRY (BUY &amp; SELL)" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="PriceEntryModeSelector" SelectedIndex="0" ToolTip="Type exact price: reads the live top bid / lowest ask in the order dialog, types the exact gold/silver/copper, and checks the Total before placing (sells never below break-even). Click top row: the older method, clicks the first row and taps the spinner; less reliable on high ping.">
                                            <ComboBoxItem Content="Type exact price (recommended)" Tag="TypeExact" />
                                            <ComboBoxItem Content="Click top row (older)" Tag="ClickRow" />
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="LatencyDescriptionText" Text="High Ping (200–300 ms): Tuned for VN -&gt; EU Frankfurt without VPN/Mudfish." Style="{StaticResource HintText}" Margin="0,0,0,4" />
                                <TextBlock x:Name="Gw2DetectHealthText" Text="Windows DPI scale check pending..." Style="{StaticResource HintText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: TRADING & PORTFOLIO -->
            <TabItem Header="Trading &amp; Portfolio">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel Margin="4">
                        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource GlyphIcon}" FontSize="15" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Profit Rules, Order Margins &amp; Portfolio Intelligence" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                                <TextBlock Text="Includes 15% GW2 fee math (5% listing + 10% exchange). Enable Portfolio Intelligence to boost proven winners and guard against ledger losers." Style="{StaticResource HintText}" Margin="0,0,0,10" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="MINIMUM PROFIT %" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="MinimumProfitBox" Tag="MinProfit" TextChanged="TunedField_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="MAX BUY PRICE (GOLD)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="MaximumBuyGoldBox" Tag="MaxBuy" TextChanged="TunedField_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="DEFAULT QUANTITY" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="DefaultQuantityBox" Text="1" Tag="Quantity" TextChanged="TunedField_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="GOLD FLOOR (NO BUY)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="GoldThresholdNoBuyBox" Tag="GoldFloor" TextChanged="TunedField_TextChanged" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="OVERBID MIN (c)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="OverbidMinBox" Text="1" Tag="Overbid" TextChanged="TunedField_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="OVERBID MAX (c)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="OverbidMaxBox" Text="5" Tag="Overbid" TextChanged="TunedField_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="UNDERCUT MIN (c)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="UndercutMinBox" Text="1" Tag="Undercut" TextChanged="TunedField_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="UNDERCUT MAX (c)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="UndercutMaxBox" Text="5" Tag="Undercut" TextChanged="TunedField_TextChanged" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="UsePortfolioIntelligenceCheckBox" Content="Use Income &amp; Portfolio ledger history (boost fast winners, auto-skip chronic losers &amp; heavy sell stacks)" IsChecked="True" Margin="0,0,0,6" />
                                <CheckBox x:Name="AutomateOnLaunchCheckBox" Content="On launch: sync my GW2 account and scan the market" IsChecked="True" Margin="0,0,0,6" ToolTip="Fills Income &amp; Portfolio and the Market Scanner when Mmopal opens. If the session uses the scanner's list and it is older than the Auto re-scan interval, the fresh scan replaces it." />
                                <CheckBox x:Name="AutoTuneEachSessionCheckBox" Content="Auto-Tune at every launch and Start session (recommended unless you tune by hand)" IsChecked="True" Margin="0,0,0,6" ToolTip="Sizes buy limits from your total gold (wallet + gold in orders) and adjusts them from your last 14 days of flips: thin margins raise Min ROI, slow sales demand busier items, gold stuck in listings slows buying, idle gold with profitable flips raises order size. Never changes settings mid-session. Any of those you change by hand is kept: Auto-Tune then tunes only the rest." />
                                <DockPanel x:Name="AutoTuneKeepsPanel" Visibility="Collapsed" Margin="26,0,0,6">
                                    <Button x:Name="ClearAutoTuneKeepsButton" DockPanel.Dock="Right" Content="Let Auto-Tune decide" Click="ClearAutoTuneKeeps_Click" Padding="10,3" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Forget your hand-set values; Auto-Tune sets them again at the next launch or Start session." />
                                    <TextBlock x:Name="AutoTuneKeepsText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                                <CheckBox x:Name="RelistStaleSellsCheckBox" Content="Relist listings undercut for 12 h+ (items that trade, only if the new price still covers what you paid plus the lost 5% fee)" IsChecked="True" Margin="0,0,0,6" ToolTip="Each relist pays a new 5% listing fee, so this is narrow: listed 12 h or more, undercut, on the scanner's list (it trades), at most once a day per item, and only when the new price still nets more than what Mmopal paid plus the fee lost on the old listing. Anything else waits." />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Keep at most" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="MaxBuyOrderShareBox" Text="50" Width="56" VerticalAlignment="Center" ToolTip="Share of your total gold (wallet + buy orders + listings after fees) that may sit in buy orders. 0 = no limit." />
                                    <TextBlock Text="% of my gold in buy orders (the rest stays free for items that fill)" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox x:Name="UseCustomListOnStartCheckBox" Content="Include Custom Shopping List &amp; Blacklist automatically on Start session" IsChecked="True" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE823;" Style="{StaticResource GlyphIcon}" FontSize="15" Foreground="{DynamicResource WarningBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Session Cap, Parked Characters &amp; Keybinds" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="MAX SESSION (HRS)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="MaxSessionHoursBox" Text="10" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="PARKED CHARS" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ParkedCharactersBox" Text="4" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="INTERACT KEY" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="InteractKeyBox" Text="F" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="TP KEY" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="TpKeyBox" Text="O" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1.6*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="SWAP EVERY (HRS)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="SwapCharacterHoursBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="JITTER (± MINS)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="SwapJitterMinutesBox" Text="15" />
                                    </StackPanel>
                                    <CheckBox x:Name="RandomCharacterSwapCheckBox" Grid.Column="2" Content="Pick random character on swap" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                                </Grid>

                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="WHEN MAX SESSION DURATION CAP IS REACHED" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource WarningBrush}" />
                                        <CheckBox x:Name="AutoCloseGameOnCapCheckBox" Content="Finalize cycle, recheck Delivery/sell queue, log out &amp; close Guild Wars 2" IsChecked="True" Margin="0,2,0,6" />
                                        <CheckBox x:Name="AutoCloseAppOnCapCheckBox" Content="Save Session Report and close Mmopal automatically after countdown" IsChecked="True" Margin="0,0,0,6" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="ShutdownPcOnCapCheckBox" Content="Shut down this PC automatically after countdown (safe unattended overnight shutdown)" IsChecked="False" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="COUNTDOWN (S)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBox x:Name="PcShutdownCountdownBox" Text="60" Width="72" Padding="6,4" HorizontalContentAlignment="Center" ToolTip="Countdown seconds (10–600) shown in warning dialog before closing app / shutting down PC." />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: HOTKEYS & ADVANCED -->
            <TabItem Header="Hotkeys &amp; Advanced">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel Margin="4">
                        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="&#xE765;" Style="{StaticResource GlyphIcon}" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Global Hotkeys (System-Wide)" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="PAUSE / RESUME" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="PauseHotkeyBox" Text="Ctrl+Shift+P" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="STOP SESSION" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="StopHotkeyBox" Text="Ctrl+Shift+S" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="EMERGENCY STOP" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="EmergencyStopHotkeyBox" Text="Ctrl+Shift+X" />
                                    </StackPanel>
                                    <Button x:Name="ApplyHotkeysButton" Grid.Column="3" Content="Apply Hotkeys" Tag="&#xE73E;" Click="ApplyHotkeys_Click" VerticalAlignment="Bottom" />
                                </Grid>
                                <TextBlock x:Name="HotkeyStatusText" Text="Global hotkeys active when the app is running." Style="{StaticResource HintText}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource GlyphIcon}" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Replay, Recording &amp; File Paths" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="CANDIDATES PATH (JSON / CSV)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="CandidatesPathBox" ToolTip="Optional JSON or CSV list of items to evaluate." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="BLACKLIST PATH (JSON / CSV)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="BlacklistPathBox" ToolTip="Optional extra blacklist file merged with your in-app blacklist." />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="FIXTURE PATH (JSONL REPLAY)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="FixturePathBox" ToolTip="Optional JSONL observation fixture to replay." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="RECORDING PATH (JSONL OUTPUT)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="RecordPathBox" ToolTip="Optional JSONL path for recording screen observations." />
                                    </StackPanel>
                                </Grid>
                                <DockPanel>
                                    <CheckBox x:Name="CaptureFramesCheckBox" Content="Capture raw BGRA32 frames alongside recordings" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Content="Open Data Folder" Tag="&#xE838;" Click="OpenDataFolder_Click" HorizontalAlignment="Right" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,12,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE9F9;" Style="{StaticResource GlyphIcon}" FontSize="15" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Trade Session Report Eligibility" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                                <TextBlock Text="Controls which finished runs are archived to the Session Reports tab (ignores quick accidental Live start/stops unless trades or bugs happened)." Style="{StaticResource HintText}" Margin="0,0,0,10" />
                                <CheckBox x:Name="SaveSessionReportsCheckBox" Content="Archive eligible trade session reports automatically" IsChecked="True" Margin="0,0,0,6" />
                                <CheckBox x:Name="ReportIncludeDryRunCheckBox" Content="Also archive Dry run &amp; Observe sessions (otherwise Live sessions only)" IsChecked="False" Margin="0,0,0,6" />
                                <CheckBox x:Name="ReportSaveOnTradesCheckBox" Content="Always save if any buy/sell order, delivery pickup, or character swap occurred" IsChecked="True" Margin="0,0,0,6" />
                                <CheckBox x:Name="ReportSaveOnErrorsCheckBox" Content="Always save if any error, bug, recovery, or fault halt occurred" IsChecked="True" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="MIN DURATION WITHOUT TRADES (MINS)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ReportMinDurationBox" Text="5" ToolTip="Minimum session length in minutes before a quiet session (no trades/errors) is saved." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="MAX SAVED REPORTS IN ARCHIVE" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="MaxSavedReportsBox" Text="100" ToolTip="Retention limit (10–1000) before oldest reports are pruned." />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
