<UserControl x:Class="Mmopal.Desktop.Pages.ListsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="ListsView" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Lists &amp; Blacklist" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Curate your custom flip targets and block items you never want evaluated. Saved automatically to your local profiles folder." Style="{StaticResource HintText}" Margin="0,3,0,0" />
        </StackPanel>

        <Grid x:Name="ListsSplitGrid" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ListsTopRow" Height="*" />
                <RowDefinition x:Name="ListsBottomRow" Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListsLeftCol" Width="1.2*" />
                <ColumnDefinition x:Name="ListsRightCol" Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Custom Shopping List Card -->
            <Border x:Name="CustomListCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Clean Symmetric Header -->
                    <StackPanel Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7BF;" Style="{StaticResource GlyphIcon}" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Custom Shopping List" Style="{StaticResource SectionTitle}" />
                                <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="CustomListCountText" Text="0 items" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Use for Session" Tag="&#xE73E;" Style="{StaticResource SuccessButton}" Height="30" MinHeight="30" Padding="10,0" FontSize="11.5" Click="UseCustomListForSession_Click" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Explicit flip targets evaluated in Live &amp; Dry run sessions." Style="{StaticResource HintText}" FontSize="11.5" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Even 2-row Input Strip (34px height locked across every control) -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.1*" MinWidth="120" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ITEM NAME" Style="{StaticResource FieldLabel}" Margin="0,0,8,5" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="RARITY" Style="{StaticResource FieldLabel}" Margin="0,0,8,5" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="QTY" Style="{StaticResource FieldLabel}" Margin="0,0,8,5" />

                        <TextBox x:Name="CustomItemNameBox" Grid.Row="1" Grid.Column="0" Height="34" Margin="0,0,8,0" KeyDown="CustomItemInput_KeyDown" ToolTip="Exact Guild Wars 2 item name (press Enter to add)" />
                        <ComboBox x:Name="CustomItemRaritySelector" Grid.Row="1" Grid.Column="1" Height="34" SelectedIndex="0" Margin="0,0,8,0">
                            <ComboBoxItem Content="Basic" />
                            <ComboBoxItem Content="Fine" />
                            <ComboBoxItem Content="Masterwork" />
                            <ComboBoxItem Content="Rare" />
                            <ComboBoxItem Content="Exotic" />
                            <ComboBoxItem Content="Ascended" />
                        </ComboBox>
                        <TextBox x:Name="CustomItemQtyBox" Grid.Row="1" Grid.Column="2" Height="34" Text="1" HorizontalContentAlignment="Center" Margin="0,0,8,0" KeyDown="CustomItemInput_KeyDown" ToolTip="Target order quantity" />
                        <Button Grid.Row="1" Grid.Column="3" Content="Add" Tag="&#xE710;" Style="{StaticResource PrimaryButton}" Height="34" MinWidth="78" Padding="12,0" FontSize="12.5" Click="AddCustomItem_Click" />
                    </Grid>

                    <DataGrid x:Name="CustomShoppingListGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ITEM NAME" Binding="{Binding ItemName}" Width="2*" MinWidth="120" />
                            <DataGridTextColumn Header="RARITY" Binding="{Binding Rarity}" Width="0.8*" MinWidth="70" />
                            <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="0.5*" MinWidth="46" />
                            <DataGridTextColumn Header="BUY (c)" Binding="{Binding BuyPriceCopper}" Width="0.75*" MinWidth="66" />
                            <DataGridTextColumn Header="SELL (c)" Binding="{Binding SellPriceCopper}" Width="0.75*" MinWidth="66" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Remove" Tag="&#xE74D;" Click="RemoveCustomItem_Click" Height="34" Padding="12,0" FontSize="12" Margin="0,0,8,4" ToolTip="Remove selected item from Shopping List" />
                        <Button Content="Import" Tag="&#xE8E5;" Click="ImportCustomList_Click" Height="34" Padding="12,0" FontSize="12" Margin="0,0,8,4" ToolTip="Import Shopping List from CSV or JSON" />
                        <Button Content="Export CSV" Tag="&#xE74E;" Click="ExportCustomList_Click" Height="34" Padding="12,0" FontSize="12" Margin="0,0,0,4" ToolTip="Export Shopping List to CSV" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Blacklist Card -->
            <Border x:Name="BlacklistCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Clean Symmetric Header -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MinHeight="30">
                            <TextBlock Text="&#xE8F8;" Style="{StaticResource GlyphIcon}" FontSize="16" Foreground="{DynamicResource DangerBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Blacklisted Items" Style="{StaticResource SectionTitle}" />
                            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="BlacklistCountText" Text="0 blocked" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Names or wildcards (*) skipped across Market Scanner &amp; live sessions." Style="{StaticResource HintText}" FontSize="11.5" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Even 2-row Input Strip matching Custom Shopping List -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="130" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="NAME OR WILDCARD (*)" Style="{StaticResource FieldLabel}" Margin="0,0,8,5" />
                        <TextBox x:Name="BlacklistInputBox" Grid.Row="1" Grid.Column="0" Height="34" Margin="0,0,8,0" KeyDown="BlacklistInput_KeyDown" ToolTip="Item name or wildcard pattern (e.g. 'Recipe:*') — press Enter to block" />
                        <Button Grid.Row="1" Grid.Column="1" Content="Block" Tag="&#xE710;" Style="{StaticResource DangerButton}" Height="34" MinWidth="82" Padding="12,0" FontSize="12.5" Click="AddBlacklistItem_Click" />
                    </Grid>

                    <Border Grid.Row="2" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="10,7">
                                <TextBlock Text="ITEM NAME OR WILDCARD PATTERN" Style="{StaticResource FieldLabel}" Margin="0" />
                            </Border>
                            <ListBox x:Name="BlacklistListBox" Grid.Row="1" BorderThickness="0" Padding="4" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>

                    <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Remove" Tag="&#xE74D;" Click="RemoveBlacklistItem_Click" Height="34" Padding="12,0" FontSize="12" Margin="0,0,8,4" ToolTip="Remove selected entry from Blacklist" />
                        <Button Content="Import" Tag="&#xE8E5;" Click="ImportBlacklist_Click" Height="34" Padding="12,0" FontSize="12" Margin="0,0,8,4" ToolTip="Import Blacklist from CSV, JSON, or TXT" />
                        <Button Content="Export CSV" Tag="&#xE74E;" Click="ExportBlacklist_Click" Height="34" Padding="12,0" FontSize="12" Margin="0,0,0,4" ToolTip="Export Blacklist to CSV" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
